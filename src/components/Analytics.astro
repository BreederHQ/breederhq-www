---
import VercelAnalytics from '@vercel/analytics/astro';

/**
 * Analytics Component
 *
 * Consent-gated tools (GA4, Ahrefs, GTM, Meta, LinkedIn, X) are NOT in the
 * HTML. Only their IDs are, as inert JSON; src/lib/consent.ts injects the
 * script tags after the visitor accepts (see ConsentBanner.astro). Before
 * that, no request leaves the browser for any of them, and window.gtag and
 * window.dataLayer do not exist, so tracking.ts events are no-ops.
 *
 * Always on, because they are cookieless or are error reports: Vercel
 * Analytics and Sentry.
 *
 * Session recording and visitor-identification tools were removed outright:
 * this site runs none.
 */

const {
  PUBLIC_GA4_MEASUREMENT_ID,
  PUBLIC_GTM_CONTAINER_ID,
  PUBLIC_META_PIXEL_ID,
  PUBLIC_LINKEDIN_PARTNER_ID,
  PUBLIC_TWITTER_PIXEL_ID,
  PUBLIC_SENTRY_DSN,
} = import.meta.env;

// Only load in production (not in dev mode)
const isProduction = import.meta.env.PROD;

const consentConfig = isProduction
  ? {
      ga4Id: PUBLIC_GA4_MEASUREMENT_ID || undefined,
      gtmId: PUBLIC_GTM_CONTAINER_ID || undefined,
      metaPixelId: PUBLIC_META_PIXEL_ID || undefined,
      linkedinPartnerId: PUBLIC_LINKEDIN_PARTNER_ID || undefined,
      twitterPixelId: PUBLIC_TWITTER_PIXEL_ID || undefined,
      ahrefsKey: 'ZBYYm0DE5zd5kH0+5L1vdw',
    }
  : {};
const consentConfigJson = JSON.stringify(consentConfig).replace(/</g, '\\u003c');
---

<!-- IDs for the consent-gated tools. Inert data: nothing loads from this. -->
<script is:inline type="application/json" id="bhq-consent-config" set:html={consentConfigJson}></script>

{isProduction && (
  <>
    <!-- Sentry Error Tracking -->
    {PUBLIC_SENTRY_DSN && (
      <script is:inline define:vars={{ sentryDsn: PUBLIC_SENTRY_DSN }}>
        (function() {
          var script = document.createElement('script');
          script.src = 'https://browser.sentry-cdn.com/7.x/bundle.min.js';
          script.crossOrigin = 'anonymous';
          script.onload = function() {
            Sentry.init({
              dsn: sentryDsn,
              integrations: [new Sentry.BrowserTracing()],
              tracesSampleRate: 0.1,
            });
          };
          document.head.appendChild(script);
        })();
      </script>
    )}

    <!-- Vercel Analytics (cookieless, first party) -->
    <VercelAnalytics />
  </>
)}

<!-- Development mode indicator -->
{!isProduction && (
  <script is:inline>
    console.log('🚧 Development mode - Analytics disabled');
  </script>
)}
