---
interface Props {
  hideLogo?: boolean;
}
const { hideLogo = false } = Astro.props;
---

<!-- Founders Banner -->
<div data-pagefind-ignore="all" style="position:relative;z-index:60;overflow:hidden;display:flex;align-items:center;justify-content:center;flex-wrap:wrap;gap:10px 16px;padding:11px 20px;font-size:13.5px;background:linear-gradient(90deg,#FF6A2C,#FF9A3C 55%,#FFB020);text-align:center">
  <span style="position:absolute;top:0;bottom:0;left:0;width:40%;background:linear-gradient(90deg,transparent,rgba(255,255,255,.35),transparent);animation:bhqSweep 4.5s linear infinite;pointer-events:none"></span>
  <span style="position:relative;display:inline-flex;align-items:center;gap:7px;font-family:'JetBrains Mono',monospace;font-size:10.5px;font-weight:600;letter-spacing:.16em;color:#3A1602">&#9733; FOUNDING MEMBER</span>
  <span style="position:relative;font-weight:700;color:#241004">50% off Pro &amp; Enterprise for your first 12 months</span>
  <a href="/founders" style="position:relative;display:inline-flex;align-items:center;gap:6px;padding:6px 15px;border-radius:999px;font-weight:700;font-size:12.5px;color:#FFFFFF;background:#151E30;box-shadow:0 3px 12px rgba(20,15,10,.35)">Claim yours <span style="font-size:14px">&#8594;</span></a>
</div>

<!-- Sticky Nav Shell -->
<header
  id="bhq-nav"
  style="position:sticky;top:0;z-index:50;background:rgba(7,12,22,.66);backdrop-filter:blur(18px);-webkit-backdrop-filter:blur(18px);border-bottom:1px solid rgba(255,255,255,.07)"
>
  <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
    <div class="flex items-center justify-between h-16 gap-6">

      <!-- Logo -->
      {!hideLogo && (
        <a href="/" class="flex items-center gap-2.5 shrink-0 group" aria-label="BreederHQ home">
          <img
            src="/logo.png"
            alt="BreederHQ"
            width="34"
            height="34"
            class="object-contain"
            style="filter:drop-shadow(0 0 8px rgba(255,106,44,.55))"
          />
          <span class="text-base font-bold tracking-tight" style="font-family:'Sora',system-ui,sans-serif;color:#EAF1FC">
            Breeder<span style="color:#FF6A2C">HQ</span>
          </span>
        </a>
      )}

      <!-- Desktop Nav Items -->
      <nav class="hidden lg:flex items-center gap-1 flex-1" aria-label="Main navigation">

        <!-- Platform -->
        <div class="relative" data-nav-item="platform">
          <button
            data-nav-trigger="platform"
            class="nav-trigger flex items-center gap-1 px-3 py-2 rounded-lg text-sm transition-colors"
            style="color:#A9BAD4;font-family:'Sora',system-ui,sans-serif"
            aria-expanded="false"
            aria-haspopup="true"
          >
            Platform
            <svg class="nav-chevron w-3.5 h-3.5 transition-transform duration-200" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5"><path stroke-linecap="round" stroke-linejoin="round" d="M19 9l-7 7-7-7"/></svg>
          </button>

          <div
            data-nav-dropdown="platform"
            class="nav-dropdown absolute top-full left-0 mt-2 hidden"
            style="min-width:640px;background:linear-gradient(180deg,#0E1A2E,#0A1424);border:1px solid rgba(255,255,255,.12);border-radius:14px;box-shadow:0 24px 60px rgba(0,0,0,.6);padding:20px"
          >
            <!-- CTA card -->
            <a
              href="https://accounts.breederhq.com/register?intent=breeder_dashboard"
              class="flex gap-3 items-center p-3 rounded-lg mb-5 transition-colors"
              style="background:rgba(255,106,44,.1);border:1px solid rgba(255,138,76,.25)"
              onmouseover="this.style.background='rgba(255,106,44,.15)'"
              onmouseout="this.style.background='rgba(255,106,44,.1)'"
            >
              <img src="/logo.png" alt="BreederHQ" class="h-10 w-10 object-contain shrink-0" />
              <div>
                <div class="text-sm font-semibold text-white">Start Your Free Trial</div>
                <div class="text-xs" style="color:#A9BAD4">14 days free — cancel anytime</div>
              </div>
            </a>

            <!-- 3-col grid -->
            <div class="grid grid-cols-3 gap-6">

              <!-- Col 1: Platform Workflows -->
              <div>
                <div class="mb-3 text-[10px] font-semibold tracking-[.16em] uppercase" style="font-family:'JetBrains Mono',monospace;color:#647a9a">Platform Workflows</div>
                <ul class="space-y-1">
                  {[
                    ['Breeding Cycles', '/workflows/breeding-cycles'],
                    ['Breeding Intelligence', '/workflows/breeding-intelligence'],
                    ['Genetics & Health', '/workflows/genetics-and-health-testing'],
                    ['Offspring Care', '/workflows/offspring-care'],
                    ['Rearing & Temperament', '/workflows/rearing-protocols'],
                    ['Pedigrees', '/workflows/pedigrees'],
                    ['Health & Medications', '/workflows/medication-tracking'],
                    ['Scout AI', '/workflows/scout-ai'],
                    ['Mobile Companion', '/mobile'],
                  ].map(([label, href]) => (
                    <li>
                      <a href={href} class="dd-link block py-1 px-2 rounded-md text-sm transition-colors" style="color:#A9BAD4">{label}</a>
                    </li>
                  ))}
                </ul>
              </div>

              <!-- Col 2: Business Tools -->
              <div>
                <div class="mb-3 text-[10px] font-semibold tracking-[.16em] uppercase" style="font-family:'JetBrains Mono',monospace;color:#647a9a">Business Tools</div>
                <ul class="space-y-1">
                  {[
                    ['Waitlists & Placement', '/workflows/waitlists-and-placement'],
                    ['Buyer Management', '/workflows/client-management'],
                    ['Client Portal', '/workflows/client-portal'],
                    ['Communications Hub', '/workflows/communications-hub'],
                    ['Invoicing & Expenses', '/workflows/invoicing-expenses'],
                    ['Marketplace Listings', '/workflows/marketplace'],
                  ].map(([label, href]) => (
                    <li>
                      <a href={href} class="dd-link block py-1 px-2 rounded-md text-sm transition-colors" style="color:#A9BAD4">{label}</a>
                    </li>
                  ))}
                </ul>
              </div>

              <!-- Col 3: Discover -->
              <div>
                <div class="mb-3 text-[10px] font-semibold tracking-[.16em] uppercase" style="font-family:'JetBrains Mono',monospace;color:#647a9a">Discover</div>
                <div class="grid grid-cols-3 gap-x-1 gap-y-1 mb-3">
                  {[
                    ['Dogs', '/dogs'],
                    ['Cats', '/cats'],
                    ['Horses', '/horses'],
                    ['Alpacas', '/alpacas'],
                    ['Goats', '/goats'],
                    ['Sheep', '/sheep'],
                    ['Cattle', '/cattle'],
                    ['Llamas', '/llamas'],
                    ['Rabbits', '/rabbits'],
                  ].map(([label, href]) => (
                    <a href={href} class="dd-link text-xs py-1 px-1.5 rounded transition-colors" style="color:#A9BAD4">{label}</a>
                  ))}
                </div>
                <div style="border-top:1px solid rgba(255,255,255,.07)" class="pt-3 space-y-1">
                  {[
                    ['Features', '/features'],
                    ['Pricing', '/pricing'],
                    ['Compare Plans', '/pricing/compare'],
                    ['Free Tools', '/tools'],
                  ].map(([label, href]) => (
                    <a href={href} class="dd-link block py-1 px-2 rounded-md text-sm transition-colors" style="color:#A9BAD4">{label}</a>
                  ))}
                </div>
              </div>

            </div>
          </div>
        </div>

        <!-- Marketplace -->
        <div class="relative" data-nav-item="marketplace">
          <button
            data-nav-trigger="marketplace"
            class="nav-trigger flex items-center gap-1 px-3 py-2 rounded-lg text-sm transition-colors"
            style="color:#A9BAD4;font-family:'Sora',system-ui,sans-serif"
            aria-expanded="false"
            aria-haspopup="true"
          >
            Marketplace
            <svg class="nav-chevron w-3.5 h-3.5 transition-transform duration-200" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5"><path stroke-linecap="round" stroke-linejoin="round" d="M19 9l-7 7-7-7"/></svg>
          </button>

          <div
            data-nav-dropdown="marketplace"
            class="nav-dropdown absolute top-full left-0 mt-2 hidden"
            style="min-width:660px;background:linear-gradient(180deg,#0E1A2E,#0A1424);border:1px solid rgba(255,255,255,.12);border-radius:14px;box-shadow:0 24px 60px rgba(0,0,0,.6);padding:20px"
          >
            <!-- CTA card -->
            <a
              href="https://marketplace.breederhq.com"
              class="flex gap-3 items-center p-3 rounded-lg mb-5 transition-colors"
              style="background:rgba(255,106,44,.1);border:1px solid rgba(255,138,76,.25)"
              onmouseover="this.style.background='rgba(255,106,44,.15)'"
              onmouseout="this.style.background='rgba(255,106,44,.1)'"
            >
              <img src="/logo.png" alt="BreederHQ" class="h-10 w-10 object-contain shrink-0" />
              <div>
                <div class="text-sm font-semibold text-white">Browse the Marketplace</div>
                <div class="text-xs" style="color:#A9BAD4">Find verified breeders and providers</div>
              </div>
            </a>

            <div class="grid grid-cols-3 gap-6">

              <!-- Col 1: For Buyers -->
              <div>
                <div class="mb-3 text-[10px] font-semibold tracking-[.16em] uppercase" style="font-family:'JetBrains Mono',monospace;color:#647a9a">For Buyers</div>
                <ul class="space-y-1">
                  {[
                    ['Marketplace Overview', '/buyers'],
                    ['Find Breeders', '/find-breeders'],
                    ['BreederHQ vs Other Sites', '/buyers/why-breederhq-marketplace'],
                    ['How to Use', '/buyers/using-the-marketplace'],
                    ['How to Evaluate Breeders', '/buyers/evaluate-breeders'],
                    ['Understanding Health Testing', '/buyers/health-tests'],
                    ['Red Flags to Avoid', '/buyers/red-flags'],
                  ].map(([label, href]) => (
                    <li>
                      <a href={href} class="dd-link block py-1 px-2 rounded-md text-sm transition-colors" style="color:#A9BAD4">{label}</a>
                    </li>
                  ))}
                </ul>
              </div>

              <!-- Col 2: For Providers -->
              <div>
                <div class="mb-3 text-[10px] font-semibold tracking-[.16em] uppercase" style="font-family:'JetBrains Mono',monospace;color:#647a9a">For Providers</div>
                <ul class="space-y-1 mb-3">
                  <li>
                    <a href="/for-providers" class="dd-link block py-1 px-2 rounded-md text-sm transition-colors" style="color:#A9BAD4">Why List on BreederHQ</a>
                  </li>
                </ul>
                <div class="mb-2 text-[9px] font-semibold tracking-[.12em] uppercase" style="font-family:'JetBrains Mono',monospace;color:#4a6080">Equine &amp; Livestock</div>
                <ul class="space-y-1 mb-3">
                  {[
                    ['Farriers', '/services/farriers'],
                    ['Equine Boarding', '/services/equine-boarding'],
                    ['Equine Services', '/services/equine-services'],
                    ['Livestock Services', '/services/livestock-services'],
                  ].map(([label, href]) => (
                    <li>
                      <a href={href} class="dd-link block py-1 px-2 rounded-md text-sm transition-colors" style="color:#A9BAD4">{label}</a>
                    </li>
                  ))}
                </ul>
                <div class="mb-2 text-[9px] font-semibold tracking-[.12em] uppercase" style="font-family:'JetBrains Mono',monospace;color:#4a6080">Care &amp; Logistics</div>
                <ul class="space-y-1">
                  {[
                    ['Dog Training', '/services/dog-training'],
                    ['Grooming', '/services/grooming'],
                    ['Boarding', '/services/boarding'],
                    ['Vet Specialists', '/services/veterinary-specialists'],
                    ['Transport', '/services/transport'],
                  ].map(([label, href]) => (
                    <li>
                      <a href={href} class="dd-link block py-1 px-2 rounded-md text-sm transition-colors" style="color:#A9BAD4">{label}</a>
                    </li>
                  ))}
                </ul>
              </div>

              <!-- Col 3: Identity -->
              <div>
                <div class="mb-3 text-[10px] font-semibold tracking-[.16em] uppercase" style="font-family:'JetBrains Mono',monospace;color:#647a9a">Identity</div>
                <ul class="space-y-1 mb-4">
                  {[
                    ['Identity & Credentials', '/trust'],
                    ['Breed Clubs', '/for-breed-clubs'],
                    ['Facilities', '/facilities'],
                  ].map(([label, href]) => (
                    <li>
                      <a href={href} class="dd-link block py-1 px-2 rounded-md text-sm transition-colors" style="color:#A9BAD4">{label}</a>
                    </li>
                  ))}
                </ul>
                <div style="border-top:1px solid rgba(255,255,255,.07)" class="pt-3">
                  <a
                    href="https://accounts.breederhq.com/register?intent=provider_marketplace"
                    class="dd-link block py-1 px-2 rounded-md text-sm font-medium transition-colors"
                    style="color:#FF9A3C"
                  >List Your Services →</a>
                </div>
              </div>

            </div>
          </div>
        </div>

        <!-- Who It's For -->
        <div class="relative" data-nav-item="who">
          <button
            data-nav-trigger="who"
            class="nav-trigger flex items-center gap-1 px-3 py-2 rounded-lg text-sm transition-colors"
            style="color:#A9BAD4;font-family:'Sora',system-ui,sans-serif"
            aria-expanded="false"
            aria-haspopup="true"
          >
            Who it's for
            <svg class="nav-chevron w-3.5 h-3.5 transition-transform duration-200" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5"><path stroke-linecap="round" stroke-linejoin="round" d="M19 9l-7 7-7-7"/></svg>
          </button>

          <div
            data-nav-dropdown="who"
            class="nav-dropdown absolute top-full left-0 mt-2 hidden"
            style="min-width:400px;background:linear-gradient(180deg,#0E1A2E,#0A1424);border:1px solid rgba(255,255,255,.12);border-radius:14px;box-shadow:0 24px 60px rgba(0,0,0,.6);padding:20px"
          >
            <div class="grid grid-cols-2 gap-6">
              <div>
                <div class="mb-3 text-[10px] font-semibold tracking-[.16em] uppercase" style="font-family:'JetBrains Mono',monospace;color:#647a9a">Breeders</div>
                <ul class="space-y-1">
                  <li><a href="/for-breeders" class="dd-link block py-1 px-2 rounded-md text-sm transition-colors" style="color:#A9BAD4">Why BreederHQ</a></li>
                  <li>
                    <a
                      href="https://accounts.breederhq.com/register?intent=breeder_dashboard"
                      class="dd-link block py-1 px-2 rounded-md text-sm font-medium transition-colors"
                      style="color:#FF9A3C"
                    >Start Free Trial →</a>
                  </li>
                </ul>
              </div>
              <div>
                <div class="mb-3 text-[10px] font-semibold tracking-[.16em] uppercase" style="font-family:'JetBrains Mono',monospace;color:#647a9a">Buyers &amp; Beyond</div>
                <ul class="space-y-1">
                  {[
                    ['For Buyers', '/buyers'],
                    ['For Providers', '/for-providers'],
                    ['For Breed Clubs', '/for-breed-clubs'],
                    ['Browse Marketplace', 'https://marketplace.breederhq.com'],
                  ].map(([label, href]) => (
                    <li>
                      <a href={href} class="dd-link block py-1 px-2 rounded-md text-sm transition-colors" style="color:#A9BAD4">{label}</a>
                    </li>
                  ))}
                </ul>
              </div>
            </div>
          </div>
        </div>

        <!-- Pricing -->
        <div class="relative" data-nav-item="pricing">
          <button
            data-nav-trigger="pricing"
            class="nav-trigger flex items-center gap-1 px-3 py-2 rounded-lg text-sm transition-colors"
            style="color:#A9BAD4;font-family:'Sora',system-ui,sans-serif"
            aria-expanded="false"
            aria-haspopup="true"
          >
            Pricing
            <svg class="nav-chevron w-3.5 h-3.5 transition-transform duration-200" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5"><path stroke-linecap="round" stroke-linejoin="round" d="M19 9l-7 7-7-7"/></svg>
          </button>

          <div
            data-nav-dropdown="pricing"
            class="nav-dropdown absolute top-full left-0 mt-2 hidden"
            style="min-width:220px;background:linear-gradient(180deg,#0E1A2E,#0A1424);border:1px solid rgba(255,255,255,.12);border-radius:14px;box-shadow:0 24px 60px rgba(0,0,0,.6);padding:20px"
          >
            <ul class="space-y-1">
              {[
                ['Pricing', '/pricing'],
                ['Compare Plans', '/pricing/compare'],
                ['Features', '/features'],
                ['Breed Clubs', '/for-breed-clubs'],
              ].map(([label, href]) => (
                <li>
                  <a href={href} class="dd-link block py-1.5 px-2 rounded-md text-sm transition-colors" style="color:#A9BAD4">{label}</a>
                </li>
              ))}
            </ul>
          </div>
        </div>

      </nav>

      <!-- Right side: Search + Sign in + CTA -->
      <div class="hidden lg:flex items-center gap-3 shrink-0">
        <a
          href="/search"
          class="flex items-center justify-center w-8 h-8 rounded-lg transition-colors hover:bg-white/5"
          style="color:#A9BAD4"
          aria-label="Search"
          title="Search"
        >
          <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="m21 21-4.35-4.35M11 18a7 7 0 1 1 0-14 7 7 0 0 1 0 14Z"/></svg>
        </a>
        <a
          href="https://accounts.breederhq.com/login"
          class="text-sm transition-colors hover:text-white"
          style="color:#A9BAD4;font-family:'Sora',system-ui,sans-serif"
        >Sign in</a>
        <a
          href="https://accounts.breederhq.com/register?intent=breeder_dashboard"
          class="inline-flex items-center gap-1.5 px-4 py-2 rounded-[9px] text-sm font-semibold transition-opacity hover:opacity-90"
          style="background:linear-gradient(150deg,#FF6A2C,#FF9A3C);box-shadow:0 6px 22px rgba(255,106,44,.35);color:#0A0F1A;font-family:'Sora',system-ui,sans-serif"
        >Start free trial →</a>
      </div>

      <!-- Mobile hamburger -->
      <button
        id="bhq-mobile-toggle"
        class="lg:hidden flex flex-col justify-center items-center w-9 h-9 gap-1.5 rounded-lg transition-colors"
        style="color:#A9BAD4"
        aria-label="Toggle mobile menu"
        aria-expanded="false"
      >
        <span class="hamburger-bar block w-5 h-0.5 rounded-full bg-current transition-all duration-200"></span>
        <span class="hamburger-bar block w-5 h-0.5 rounded-full bg-current transition-all duration-200"></span>
        <span class="hamburger-bar block w-5 h-0.5 rounded-full bg-current transition-all duration-200"></span>
      </button>

    </div>
  </div>

  <!-- Mobile menu -->
  <div
    id="bhq-mobile-menu"
    class="lg:hidden hidden"
    style="background:#070C16;border-top:1px solid rgba(255,255,255,.07)"
  >
    <div class="px-4 py-4 space-y-1">

      <!-- Mobile: Platform accordion -->
      <div class="mobile-accordion" data-mobile-section="platform">
        <button
          class="mobile-acc-trigger w-full flex items-center justify-between py-2.5 px-3 rounded-lg text-sm font-medium"
          style="color:#EAF1FC;font-family:'Sora',system-ui,sans-serif"
        >
          Platform
          <svg class="mobile-chevron w-4 h-4 transition-transform duration-200" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5"><path stroke-linecap="round" stroke-linejoin="round" d="M19 9l-7 7-7-7"/></svg>
        </button>
        <div class="mobile-acc-body hidden pl-3 pb-2 space-y-1">
          {[
            ['Breeding Cycles', '/workflows/breeding-cycles'],
            ['Breeding Intelligence', '/workflows/breeding-intelligence'],
            ['Genetics & Health', '/workflows/genetics-and-health-testing'],
            ['Offspring Care', '/workflows/offspring-care'],
            ['Rearing & Temperament', '/workflows/rearing-protocols'],
            ['Pedigrees', '/workflows/pedigrees'],
            ['Health & Medications', '/workflows/medication-tracking'],
            ['Scout AI', '/workflows/scout-ai'],
            ['Mobile Companion', '/mobile'],
            ['Waitlists & Placement', '/workflows/waitlists-and-placement'],
            ['Buyer Management', '/workflows/client-management'],
            ['Client Portal', '/workflows/client-portal'],
            ['Communications Hub', '/workflows/communications-hub'],
            ['Invoicing & Expenses', '/workflows/invoicing-expenses'],
            ['Marketplace Listings', '/workflows/marketplace'],
            ['Features', '/features'],
            ['Pricing', '/pricing'],
            ['Compare Plans', '/pricing/compare'],
            ['Free Tools', '/tools'],
          ].map(([label, href]) => (
            <a href={href} class="mobile-link block py-2 px-3 rounded-lg text-sm" style="color:#A9BAD4">{label}</a>
          ))}
        </div>
      </div>

      <!-- Mobile: Marketplace accordion -->
      <div class="mobile-accordion" data-mobile-section="marketplace">
        <button
          class="mobile-acc-trigger w-full flex items-center justify-between py-2.5 px-3 rounded-lg text-sm font-medium"
          style="color:#EAF1FC;font-family:'Sora',system-ui,sans-serif"
        >
          Marketplace
          <svg class="mobile-chevron w-4 h-4 transition-transform duration-200" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5"><path stroke-linecap="round" stroke-linejoin="round" d="M19 9l-7 7-7-7"/></svg>
        </button>
        <div class="mobile-acc-body hidden pl-3 pb-2 space-y-1">
          {[
            ['Marketplace Overview', '/buyers'],
            ['Find Breeders', '/find-breeders'],
            ['BreederHQ vs Other Sites', '/buyers/why-breederhq-marketplace'],
            ['How to Evaluate Breeders', '/buyers/evaluate-breeders'],
            ['Understanding Health Testing', '/buyers/health-tests'],
            ['Red Flags to Avoid', '/buyers/red-flags'],
            ['Why List on BreederHQ', '/for-providers'],
            ['Identity & Credentials', '/trust'],
            ['Breed Clubs', '/for-breed-clubs'],
            ['Facilities', '/facilities'],
          ].map(([label, href]) => (
            <a href={href} class="mobile-link block py-2 px-3 rounded-lg text-sm" style="color:#A9BAD4">{label}</a>
          ))}
        </div>
      </div>

      <!-- Mobile: Who it's for accordion -->
      <div class="mobile-accordion" data-mobile-section="who">
        <button
          class="mobile-acc-trigger w-full flex items-center justify-between py-2.5 px-3 rounded-lg text-sm font-medium"
          style="color:#EAF1FC;font-family:'Sora',system-ui,sans-serif"
        >
          Who it's for
          <svg class="mobile-chevron w-4 h-4 transition-transform duration-200" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5"><path stroke-linecap="round" stroke-linejoin="round" d="M19 9l-7 7-7-7"/></svg>
        </button>
        <div class="mobile-acc-body hidden pl-3 pb-2 space-y-1">
          {[
            ['Why BreederHQ', '/for-breeders'],
            ['For Buyers', '/buyers'],
            ['For Providers', '/for-providers'],
            ['For Breed Clubs', '/for-breed-clubs'],
            ['Browse Marketplace', 'https://marketplace.breederhq.com'],
          ].map(([label, href]) => (
            <a href={href} class="mobile-link block py-2 px-3 rounded-lg text-sm" style="color:#A9BAD4">{label}</a>
          ))}
        </div>
      </div>

      <!-- Mobile: Pricing accordion -->
      <div class="mobile-accordion" data-mobile-section="pricing">
        <button
          class="mobile-acc-trigger w-full flex items-center justify-between py-2.5 px-3 rounded-lg text-sm font-medium"
          style="color:#EAF1FC;font-family:'Sora',system-ui,sans-serif"
