<style>
  /* Hover states for nav triggers and dropdown links */
  .nav-trigger:hover {
    color: #EAF1FC !important;
    background: rgba(255,255,255,.05);
  }
  .nav-trigger[aria-expanded="true"] {
    color: #EAF1FC !important;
    background: rgba(255,255,255,.06);
  }
  .nav-trigger[aria-expanded="true"] .nav-chevron {
    transform: rotate(180deg);
  }
  .dd-link:hover {
    color: #EAF1FC !important;
    background: rgba(255,255,255,.05);
  }
  .mobile-link:hover {
    color: #EAF1FC !important;
    background: rgba(255,255,255,.05);
  }
  .mobile-acc-trigger:hover {
    background: rgba(255,255,255,.04);
  }
  .mobile-acc-trigger[aria-expanded="true"] .mobile-chevron {
    transform: rotate(180deg);
  }
</style>

<script>
  (function () {
    // ---- Desktop dropdown logic ----
    const triggers = document.querySelectorAll('[data-nav-trigger]');
    const dropdowns = document.querySelectorAll('[data-nav-dropdown]');

    function closeAll(except?: string) {
      triggers.forEach((btn) => {
        const key = btn.getAttribute('data-nav-trigger');
        if (key === except) return;
        btn.setAttribute('aria-expanded', 'false');
        const dd = document.querySelector(`[data-nav-dropdown="${key}"]`);
        if (dd) dd.classList.add('hidden');
      });
    }

    triggers.forEach((btn) => {
      btn.addEventListener('click', (e) => {
        e.stopPropagation();
        const key = btn.getAttribute('data-nav-trigger')!;
        const dd = document.querySelector(`[data-nav-dropdown="${key}"]`);
        const isOpen = btn.getAttribute('aria-expanded') === 'true';
        closeAll(isOpen ? undefined : key);
        if (!isOpen && dd) {
          dd.classList.remove('hidden');
          btn.setAttribute('aria-expanded', 'true');
        }
      });
    });

    // Close on outside click
    document.addEventListener('click', (e) => {
      const nav = document.getElementById('bhq-nav');
      if (nav && !nav.contains(e.target as Node)) {
        closeAll();
      }
    });

    // Close on Escape
    document.addEventListener('keydown', (e) => {
      if (e.key === 'Escape') closeAll();
    });

    // ---- Mobile menu toggle ----
    const mobileToggle = document.getElementById('bhq-mobile-toggle');
    const mobileMenu = document.getElementById('bhq-mobile-menu');

    if (mobileToggle && mobileMenu) {
      mobileToggle.addEventListener('click', () => {
        const isOpen = mobileMenu.classList.contains('hidden');
        mobileMenu.classList.toggle('hidden', !isOpen);
        mobileToggle.setAttribute('aria-expanded', String(isOpen));
      });
    }

    // ---- Mobile accordion logic ----
    const mobileAccTriggers = document.querySelectorAll('.mobile-acc-trigger');
    mobileAccTriggers.forEach((btn) => {
      btn.addEventListener('click', () => {
        const section = btn.closest('.mobile-accordion');
        if (!section) return;
        const body = section.querySelector('.mobile-acc-body');
        if (!body) return;
        const isOpen = !body.classList.contains('hidden');
        // Close all others
        document.querySelectorAll('.mobile-acc-body').forEach((b) => b.classList.add('hidden'));
        document.querySelectorAll('.mobile-acc-trigger').forEach((b) => b.setAttribute('aria-expanded', 'false'));
        if (!isOpen) {
          body.classList.remove('hidden');
          btn.setAttribute('aria-expanded', 'true');
        }
      });
    });
  })();
</script>
