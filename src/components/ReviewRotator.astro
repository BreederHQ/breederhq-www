---
// Compact, quiet review rotator for pages that must stay focused (the founders
// sign-up page). One review at a time, full text, no clamping. All slides share
// one grid cell, so the block always reserves the tallest review's height and
// rotation never moves the content around it. With JS off, every review is listed.
import { SOURCE_LABELS, sortedTestimonials } from '../data/testimonials';
import '../styles/review-controls.css';

const reviews = sortedTestimonials();
---

<section
  class="rr"
  data-review-carousel
  data-review-mode="fade"
  aria-roledescription="carousel"
  aria-label="Breeder reviews"
>
  <script is:inline>
    document.currentScript.parentElement.classList.add('rr--js');
  </script>
  <div class="rr__live" data-live aria-live="off">
    <div class="rr__track" data-track>
      {
        reviews.map((r, i) => (
          <figure
            class="rr__slide"
            data-slide
            role="group"
            aria-roledescription="slide"
            aria-label={`${i + 1} of ${reviews.length}`}
          >
            <span class="rr__stars" role="img" aria-label={`${r.rating} out of 5 stars`}>
              {[1, 2, 3, 4, 5].map((n) => (
                <span aria-hidden="true" class={n <= r.rating ? 'on' : 'off'}>&#9733;</span>
              ))}
            </span>
            {r.title && <p class="rr__title">{r.title}</p>}
            <blockquote class="rr__quote">
              {r.quote.split('\n\n').map((p) => <p>{p}</p>)}
            </blockquote>
            <figcaption class="rr__who">
              {r.reviewerName}, <span>{SOURCE_LABELS[r.source]}</span>
            </figcaption>
          </figure>
        ))
      }
    </div>
  </div>
  <div class="rr__bar">
    <a href="/reviews" class="rr__all">Read All Reviews &#8594;</a>
    <div class="rr__controls">
      <button type="button" class="rv__btn rr__btn" data-prev data-js-only hidden aria-label="Previous Review">
        <svg viewBox="0 0 20 20" width="14" height="14" aria-hidden="true"><path d="M12.5 4.5 7 10l5.5 5.5" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"></path></svg>
      </button>
      <div class="rv__dots" data-dots data-js-only hidden></div>
      <button type="button" class="rv__btn rr__btn" data-next data-js-only hidden aria-label="Next Review">
        <svg viewBox="0 0 20 20" width="14" height="14" aria-hidden="true"><path d="M7.5 4.5 13 10l-5.5 5.5" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"></path></svg>
      </button>
      <button type="button" class="rv__btn rv__toggle rr__btn" data-toggle data-js-only hidden aria-label="Pause Review Rotation" aria-pressed="false">
        <svg class="i-pause" viewBox="0 0 20 20" width="12" height="12" aria-hidden="true"><path d="M6 4h3v12H6zM11 4h3v12h-3z" fill="currentColor"></path></svg>
        <svg class="i-play" viewBox="0 0 20 20" width="12" height="12" aria-hidden="true"><path d="M6 4l10 6-10 6z" fill="currentColor"></path></svg>
      </button>
    </div>
  </div>
</section>

<style is:global>
  .rr {
    max-width: 44ch;
    border-left: 2px solid rgba(255, 255, 255, 0.12);
    padding-left: 16px;
  }
  .rr__track {
    display: flex;
    flex-direction: column;
    gap: 24px;
  }
  .rr.rr--js .rr__track {
    display: grid;
    gap: 0;
  }
  .rr.rr--js .rr__slide {
    grid-area: 1 / 1;
    opacity: 0;
    visibility: hidden;
  }
  .rr.rr--js .rr__slide[data-active] {
    opacity: 1;
    visibility: visible;
  }
  @media (prefers-reduced-motion: no-preference) {
    .rr.rr--js .rr__slide {
      transition: opacity 0.4s ease, visibility 0s linear 0.4s;
    }
    .rr.rr--js .rr__slide[data-active] {
      transition: opacity 0.4s ease, visibility 0s;
    }
  }
  .rr__slide {
    margin: 0;
    display: flex;
    flex-direction: column;
    gap: 6px;
    min-width: 0;
  }
  .rr__stars {
    font-size: 13px;
    letter-spacing: 2px;
    line-height: 1;
  }
  .rr__stars .on { color: #ffb020; }
  .rr__stars .off { color: #3c4c66; }
  .rr__title {
    margin: 0;
    font-size: 13.5px;
    font-weight: 600;
    line-height: 1.35;
    color: #dbe5f3;
    overflow-wrap: anywhere;
  }
  .rr__quote {
    margin: 0;
    display: flex;
    flex-direction: column;
    gap: 8px;
    font-size: 13.5px;
    line-height: 1.55;
    color: #aec0da;
  }
  .rr__quote p {
    margin: 0;
    white-space: pre-wrap;
    overflow-wrap: anywhere;
  }
  .rr__who {
    font-size: 12.5px;
    color: #8da0bd;
  }
  .rr__who span { color: #8da0bd; }
  .rr__bar {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 8px 16px;
    flex-wrap: wrap;
    margin-top: 10px;
  }
  .rr__all {
    font-size: 13px;
    font-weight: 600;
    color: #ff8a56;
    text-decoration: none;
  }
  .rr__all:hover { text-decoration: underline; }
  .rr__all:focus-visible {
    outline: 2px solid #ff8a56;
    outline-offset: 3px;
    border-radius: 4px;
  }
  .rr__controls {
    display: flex;
    align-items: center;
    gap: 6px;
  }
  .rr__controls > [hidden] { display: none; }
  .rr .rr__btn {
    width: 28px;
    height: 28px;
  }
</style>

<script>
  import '../scripts/reviewCarousel';
</script>
