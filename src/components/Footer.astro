---
// Footer component
const year = new Date().getFullYear();
---

<footer
  data-pagefind-ignore="all"
  style="border-top:1px solid rgba(255,255,255,.07);background:rgba(0,0,0,.24)"
>
  <!-- Main columns -->
  <div style="max-width:1180px;margin:0 auto;padding:44px 30px">
    <div class="footer-grid">

      <!-- Column 1: Brand -->
      <div style="display:flex;flex-direction:column;gap:12px">
        <div style="display:flex;align-items:center;gap:9px">
          <img src="/logo.png" alt="BreederHQ logo" width="30" height="30" style="display:block;flex-shrink:0" />
          <span style="color:#ffffff;font-weight:700;font-size:15.5px;line-height:1">BreederHQ</span>
        </div>
        <p style="color:#8DA0BD;font-size:13px;line-height:1.55;max-width:260px;margin:0">
          The operating system for modern breeding professionals. Serving breeders in the US, UK, Canada, Australia &amp; Europe.
        </p>
      </div>

      <!-- Column 2: Platform -->
      <div>
        <h4 class="footer-col-heading">PLATFORM</h4>
        <nav style="display:flex;flex-direction:column;gap:9px">
          <a href="/workflows" class="footer-link">Workflows</a>
          <a href="/features" class="footer-link">Features</a>
          <a href="/pricing" class="footer-link">Pricing</a>
          <a href="/mobile" class="footer-link">Mobile app</a>
          <a href="/tools" class="footer-link">Free Tools</a>
        </nav>
      </div>

      <!-- Column 3: Marketplace -->
      <div>
        <h4 class="footer-col-heading">MARKETPLACE</h4>
        <nav style="display:flex;flex-direction:column;gap:9px">
          <a href="https://marketplace.breederhq.com" class="footer-link">Browse Breeders</a>
          <a href="/find-breeders" class="footer-link">Find Breeders</a>
          <a href="/services" class="footer-link">Find Animal Services</a>
          <a href="/for-providers" class="footer-link">For Providers</a>
          <a href="/trust" class="footer-link">Identity &amp; Credentials</a>
          <a href="/for-breed-clubs" class="footer-link">Breed Clubs</a>
        </nav>
      </div>

      <!-- Column 4: Company -->
      <div>
        <h4 class="footer-col-heading">COMPANY</h4>
        <nav style="display:flex;flex-direction:column;gap:9px">
          <a href="/about" class="footer-link">About</a>
          <a href="/articles" class="footer-link">Articles</a>
          <a href="/contact" class="footer-link">Contact</a>
          <a href="/lets-connect" class="footer-link">Let's Connect</a>
          <a href="/support" class="footer-link">Support</a>
        </nav>
      </div>

    </div>
  </div>

  <!-- Bottom bar -->
  <div style="border-top:1px solid rgba(255,255,255,.06)">
    <div
      class="footer-bottom"
      style="max-width:1180px;margin:0 auto;padding:20px 30px;display:flex;align-items:center;justify-content:space-between;flex-wrap:wrap;gap:12px;font-size:12px;color:#607a9a"
    >
      <span>&copy; {year} BreederHQ. All rights reserved.</span>
      <div style="display:flex;align-items:center;gap:20px;flex-wrap:wrap">
        <a href="/privacy" class="footer-bottom-link">Privacy</a>
        <a href="/terms" class="footer-bottom-link">Terms</a>
        <a href="/data-deletion" class="footer-bottom-link">Data Deletion</a>
        <a href="mailto:support@breederhq.com" class="footer-bottom-link">support@breederhq.com</a>
      </div>
    </div>
  </div>
</footer>

<style>
  .footer-grid {
    display: grid;
    grid-template-columns: 1.6fr 1fr 1fr 1fr;
    gap: 40px;
  }

  @media (max-width: 767px) {
    .footer-grid {
      grid-template-columns: 1fr;
      gap: 32px;
    }

    .footer-bottom {
      flex-direction: column;
      align-items: flex-start !important;
    }
  }

  .footer-col-heading {
    font-family: 'JetBrains Mono', 'Fira Mono', monospace;
    font-size: 10.5px;
    font-weight: 600;
    letter-spacing: 0.14em;
    color: #647a9a;
    margin: 0 0 14px 0;
    text-transform: uppercase;
  }

  .footer-link {
    color: #A9BAD4;
    font-size: 13px;
    text-decoration: none;
    transition: color 0.15s ease;
  }

  .footer-link:hover {
    color: #EAF1FC;
  }

  .footer-bottom-link {
    color: #607a9a;
    font-size: 12px;
    text-decoration: none;
    transition: color 0.15s ease;
  }

  .footer-bottom-link:hover {
    color: #EAF1FC;
  }
</style>
