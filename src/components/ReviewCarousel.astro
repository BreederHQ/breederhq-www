---
// Rotating carousel of every review in src/data/testimonials.ts, shown in full.
// CSS scroll-snap row: swipe works natively, and with JS off it is a plain
// horizontally scrollable row. src/scripts/reviewCarousel.ts adds the controls.
import ReviewCard from './ReviewCard.astro';
import '../styles/review-controls.css';
import { sortedTestimonials } from '../data/testimonials';

interface Props {
  heading?: string;
}

const { heading = 'What Breeders Are Saying' } = Astro.props;
const reviews = sortedTestimonials();
---

<section
  class="rv"
  data-review-carousel
  data-review-mode="scroll"
  aria-roledescription="carousel"
  aria-label="Breeder reviews"
>
  <div class="rv__head">
    <h2>{heading}</h2>
    <a href="/reviews" class="rv__all">Read All Reviews &#8594;</a>
  </div>
  <div class="rv__live" data-live aria-live="off">
    <div class="rv__track" data-track tabindex="0" role="group" aria-label="Review slides">
      {
        reviews.map((r, i) => (
          <div
            class="rv__slide"
            data-slide
            role="group"
            aria-roledescription="slide"
            aria-label={`${i + 1} of ${reviews.length}`}
          >
            <ReviewCard review={r} variant="strip" />
          </div>
        ))
      }
    </div>
  </div>
  <div class="rv__controls">
    <button type="button" class="rv__btn" data-prev data-js-only hidden aria-label="Previous Review">
      <svg viewBox="0 0 20 20" width="18" height="18" aria-hidden="true"><path d="M12.5 4.5 7 10l5.5 5.5" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"></path></svg>
    </button>
    <div class="rv__dots" data-dots data-js-only hidden></div>
    <button type="button" class="rv__btn" data-next data-js-only hidden aria-label="Next Review">
      <svg viewBox="0 0 20 20" width="18" height="18" aria-hidden="true"><path d="M7.5 4.5 13 10l-5.5 5.5" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"></path></svg>
    </button>
    <button type="button" class="rv__btn rv__toggle" data-toggle data-js-only hidden aria-label="Pause Review Rotation" aria-pressed="false">
      <svg class="i-pause" viewBox="0 0 20 20" width="16" height="16" aria-hidden="true"><path d="M6 4h3v12H6zM11 4h3v12h-3z" fill="currentColor"></path></svg>
      <svg class="i-play" viewBox="0 0 20 20" width="16" height="16" aria-hidden="true"><path d="M6 4l10 6-10 6z" fill="currentColor"></path></svg>
    </button>
  </div>
</section>

<style is:global>
  .rv {
    --rv-per: 1;
    --rv-gap: 16px;
    box-sizing: border-box;
    width: 100%;
    min-width: 0;
    max-width: 1120px;
    margin: 0 auto;
    padding: 56px 30px 20px;
  }
  @media (min-width: 640px) {
    .rv { --rv-per: 2; }
  }
  @media (min-width: 1024px) {
    .rv { --rv-per: 3; }
  }
  .rv__head {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: 12px 20px;
    flex-wrap: wrap;
    margin-bottom: 22px;
  }
  .rv__head h2 {
    margin: 0;
    font-size: clamp(24px, 3vw, 32px);
    line-height: 1.15;
    font-weight: 800;
    letter-spacing: -0.02em;
    color: #eaf1fc;
  }
  .rv__all {
    font-size: 14px;
    font-weight: 600;
    color: #ff8a56;
    text-decoration: none;
  }
  .rv__all:hover { text-decoration: underline; }
  .rv__all:focus-visible,
  .rv__track:focus-visible,
  .rv__btn:focus-visible,
  .rv-dot:focus-visible {
    outline: 2px solid #ff8a56;
    outline-offset: 3px;
    border-radius: 6px;
  }
  .rv__live { min-width: 0; }
  .rv__track {
    /* Contains the absolutely positioned .sr-only text inside each card's link,
       which would otherwise escape the scroller and widen the page. */
    position: relative;
    display: flex;
    gap: var(--rv-gap);
    align-items: stretch;
    overflow-x: auto;
    overscroll-behavior-x: contain;
    scroll-snap-type: x mandatory;
    scrollbar-width: thin;
    scrollbar-color: #3c4c66 transparent;
    padding-bottom: 6px;
  }
  .rv.is-enhanced .rv__track {
    scrollbar-width: none;
    padding-bottom: 0;
  }
  .rv.is-enhanced .rv__track::-webkit-scrollbar { display: none; }
  .rv__slide {
    flex: 0 0 calc((100% - (var(--rv-per) - 1) * var(--rv-gap)) / var(--rv-per));
    min-width: 0;
    scroll-snap-align: start;
    display: flex;
  }
  .rv__slide > .review-card { flex: 1 1 auto; width: 100%; }
  .rv__controls {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 10px;
    min-height: 44px;
    margin-top: 14px;
  }
  .rv__controls > [hidden] { display: none; }
  @media (max-width: 860px) {
    .rv { padding: 40px 16px 16px; }
  }
</style>

<script>
  import '../scripts/reviewCarousel';
</script>
