---
// The intro-call walkthrough video in a dialog over the page, opened by any
// [data-walkthrough-open] control (see IntroCallWorthIt.astro). Run by
// initWalkthroughDialog (./walkthroughDialog.ts).
//
// A native modal <dialog>: the rest of the page is inert while it is open, so
// focus stays inside it, and Escape closes it. The video frame exists only
// while the dialog is open, so closing it stops the audio.
import { INTRO_CALL_VIDEO_TITLE } from '../../lib/foundersIntroCall';
---

<dialog
  data-walkthrough-dialog
  aria-labelledby="walkthrough-dialog-title"
  class="m-auto w-[min(960px,calc(100vw-32px))] max-w-none rounded-2xl border border-white/12 bg-[#0F1B33] p-0 text-slate-100 shadow-[0_24px_64px_-12px_rgba(0,0,0,0.7)] backdrop:bg-[#070C16]/75 backdrop:backdrop-blur-sm"
>
  <div class="flex items-center justify-between gap-3 border-b border-white/10 px-4 py-3 sm:px-5">
    <h2 id="walkthrough-dialog-title" class="m-0 text-base font-semibold text-white">{INTRO_CALL_VIDEO_TITLE}</h2>
    <button
      type="button" data-walkthrough-close aria-label="Close the video"
      class="inline-flex h-10 w-10 flex-none cursor-pointer items-center justify-center rounded-lg border border-white/15 bg-white/[0.04] text-slate-200 transition hover:bg-white/10 focus:outline-none focus-visible:ring-2 focus-visible:ring-[hsl(24,95%,53%)]"
    >
      <svg class="h-4 w-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
        <path d="M18 6 6 18M6 6l12 12" />
      </svg>
    </button>
  </div>
  <div data-walkthrough-frame class="relative w-full bg-[#0A1120] aspect-video"></div>
</dialog>
