---
import { STORE_LINKS } from '../../data/storeLinks';
---

<div class="bapp-store-row">
  <a class="bapp-store bapp-store-apple" href={STORE_LINKS.appStore} rel="noopener">
    <img src="/images/badge-app-store.svg" alt="Download on the App Store" width="120" height="40" />
  </a>
  <a class="bapp-store bapp-store-play" href={STORE_LINKS.googlePlay} rel="noopener">
    <img src="/images/badge-google-play.png" alt="Get it on Google Play" width="155" height="60" />
  </a>
</div>
