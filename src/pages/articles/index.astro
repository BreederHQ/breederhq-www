---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { articles as allArticles } from '../../data/articles';

const breadcrumbs = [
  { name: 'Home', url: '/' },
  { name: 'Articles', url: '/articles' }
];

const featuredData = allArticles.find(a => a.featured)!;
const featured = {
  slug: featuredData.slug,
  title: featuredData.title,
  subtitle: featuredData.featuredSubtitle ?? '',
  excerpt: featuredData.excerpt,
  author: featuredData.author,
  role: featuredData.role,
  date: featuredData.date,
  readTime: featuredData.readTime,
  tag: featuredData.tag,
};

const nonFeatured = allArticles.filter(a => !a.featured);

// Unique tags in order of first appearance, for filter chips
const allTags = Array.from(new Set(nonFeatured.map(a => a.tag)));
---

<BaseLayout
  title="Articles | BreederHQ"
  description="Founder essays and deep-dives on breeding software, data, and running a responsible program across nine species. Read the thinking behind BreederHQ."
  breadcrumbs={breadcrumbs}
>
  <main>
    <nav class="breadcrumb py-4 px-4 bg-gray-50" aria-label="Breadcrumb">
      <ol class="flex items-center space-x-2 max-w-4xl mx-auto text-sm">
        <li><a href="/" class="text-[hsl(24,95%,53%)] hover:underline">Home</a></li>
        <li class="text-gray-400">›</li>
        <li aria-current="page" class="text-gray-600">Articles</li>
      </ol>
    </nav>

    <!-- Hero -->
    <section class="bg-gradient-to-b from-stone-50 to-white pt-12 pb-8 px-4">
      <div class="max-w-4xl mx-auto">
        <h1 class="text-5xl font-bold tracking-tight text-gray-900 leading-tight mb-3">
          Articles
        </h1>
        <p class="text-lg text-gray-600 max-w-3xl leading-relaxed">
          Founder perspectives, deep-dives, and the thinking behind BreederHQ. Long-form writing on breeding, data, AI, and the business of responsible breeding, across dogs, cats, horses, goats, rabbits, sheep, alpacas, llamas, and cattle.
        </p>
      </div>
    </section>

    <!-- Featured: Founder's Perspective -->
    <section class="pt-4 pb-4 px-4 bg-white">
      <div class="max-w-4xl mx-auto">
        <div class="featured-frame relative rounded-xl p-[2px] group">
          <a
            href={`/articles/${featured.slug}`}
            class="block bg-white rounded-[10px] shadow-sm hover:shadow-lg hover:-translate-y-0.5 transition-all duration-200 p-8 relative"
            aria-label={`Featured: ${featured.title}`}
          >
            <div class="flex items-center gap-2 mb-3">
              <span class="featured-chip inline-flex items-center text-[10px] font-bold uppercase tracking-widest text-amber-800 border border-amber-300 px-2 py-0.5 rounded">
                Featured
              </span>
              <p class="text-xs font-semibold uppercase tracking-wider text-gray-500">{featured.tag}</p>
            </div>
            <h2 class="text-2xl md:text-3xl font-bold text-gray-900 mb-1 group-hover:text-gray-700 transition">
              {featured.title}
            </h2>
            <p class="text-lg md:text-xl text-gray-500 font-medium mb-3">
              {featured.subtitle}
            </p>
            <p class="text-gray-700 leading-relaxed mb-6">
              {featured.excerpt}
            </p>
            <div class="flex items-center gap-3 text-sm text-gray-500 border-t border-gray-200 pt-4">
              <div>
                <p class="font-semibold text-gray-900">{featured.author}</p>
                <p class="text-xs">{featured.role}</p>
              </div>
              <span class="text-gray-300">&middot;</span>
              <p>{featured.date}</p>
              <span class="text-gray-300">&middot;</span>
              <p>{featured.readTime}</p>
            </div>
          </a>
        </div>
      </div>
    </section>

    <style>
      .featured-frame {
        background: linear-gradient(
          110deg,
          #b45309 0%,
          #f59e0b 20%,
          #fbbf24 35%,
          #fef3c7 50%,
          #fbbf24 65%,
          #f59e0b 80%,
          #b45309 100%
        );
        background-size: 250% 100%;
        animation: featured-frame-pan 5s linear infinite;
        box-shadow:
          0 0 0 1px rgba(245, 158, 11, 0.18),
          0 4px 14px -4px rgba(245, 158, 11, 0.35);
      }
      @keyframes featured-frame-pan {
        0%   { background-position:   0% 50%; }
        100% { background-position: 250% 50%; }
      }
      .featured-chip {
        background: linear-gradient(
          110deg,
          #fef3c7 0%,
          #fef3c7 38%,
          #fffbeb 50%,
          #fef3c7 62%,
          #fef3c7 100%
        );
        background-size: 250% 100%;
        animation: chip-shimmer 2.4s linear infinite;
      }
      @keyframes chip-shimmer {
        0%   { background-position: 250% 50%; }
        100% { background-position:   0% 50%; }
      }

      :global(body.bhq-dark-shell) .featured-frame {
        background: linear-gradient(
          110deg,
          #D97706 0%,
          #F59E0B 20%,
          #FF9F2C 35%,
          #F59E0B 50%,
          #FF9F2C 65%,
          #F59E0B 80%,
          #D97706 100%
        );
        background-size: 250% 100%;
        box-shadow:
          0 0 0 1px rgba(245, 158, 11, 0.25),
          0 4px 14px -4px rgba(245, 158, 11, 0.45);
      }
      :global(body.bhq-dark-shell) .featured-chip {
        background: linear-gradient(
          110deg,
          rgba(245,158,11,0.08) 0%,
          rgba(245,158,11,0.08) 38%,
          rgba(245,158,11,0.14) 50%,
          rgba(245,158,11,0.08) 62%,
          rgba(245,158,11,0.08) 100%
        );
        background-size: 250% 100%;
      }
    </style>

    <!-- Search + Filter -->
    <section class="px-4 bg-white pt-6 pb-2">
      <div class="max-w-4xl mx-auto">
        <!-- Search input -->
        <div class="relative mb-4">
          <svg class="absolute left-3 top-1/2 -translate-y-1/2 w-4 h-4 text-gray-400 pointer-events-none" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-4.35-4.35M17 11A6 6 0 1 1 5 11a6 6 0 0 1 12 0z"/>
          </svg>
          <input
            id="article-search"
            type="search"
            placeholder="Search articles..."
            autocomplete="off"
            class="w-full pl-9 pr-4 py-2.5 rounded-lg border border-gray-300 text-sm text-gray-900 placeholder-gray-400 focus:outline-none focus:ring-2 focus:ring-[hsl(24,95%,53%)] focus:border-transparent bg-white"
            aria-label="Search articles"
          />
        </div>
        <!-- Tag chips -->
        <div class="flex flex-wrap gap-2 pb-2" id="tag-chips" role="group" aria-label="Filter by topic">
          <button
            class="tag-chip active text-xs font-semibold px-3 py-1.5 rounded-full border transition-colors"
            data-tag="all"
            aria-pressed="true"
          >All</button>
          {allTags.map(tag => (
            <button
              class="tag-chip text-xs font-semibold px-3 py-1.5 rounded-full border transition-colors"
              data-tag={tag}
              aria-pressed="false"
            >{tag}</button>
          ))}
        </div>
      </div>
    </section>

    <!-- Section divider -->
    <section class="px-4 bg-white">
      <div class="max-w-4xl mx-auto">
        <div class="flex items-center gap-4 py-4">
          <div class="flex-1 h-px bg-gray-200"></div>
          <p class="text-xs font-semibold uppercase tracking-widest text-gray-500" id="articles-count-label">More Articles</p>
          <div class="flex-1 h-px bg-gray-200"></div>
        </div>
      </div>
    </section>

    <!-- Articles List -->
    <section class="pt-2 pb-16 px-4 bg-white">
      <div class="max-w-4xl mx-auto">
        <div class="space-y-6" id="articles-list">
          {nonFeatured.map(article => (
            <a
              href={`/articles/${article.slug}`}
              class="article-card block bg-white rounded-xl border border-gray-300 shadow-sm hover:shadow-lg hover:border-[hsl(24,95%,53%)] hover:-translate-y-0.5 transition-all duration-200 p-8 group"
              data-tag={article.tag}
              data-title={article.title.toLowerCase()}
              data-excerpt={article.excerpt.toLowerCase()}
            >
              <p class="text-xs font-semibold uppercase tracking-wider text-[hsl(24,95%,53%)] mb-3">{article.tag}</p>
              <h2 class="text-2xl md:text-3xl font-bold text-gray-900 mb-3 group-hover:text-[hsl(24,95%,53%)] transition">
                {article.title}
              </h2>
              <p class="text-gray-700 leading-relaxed mb-6">
                {article.excerpt}
              </p>
              <div class="flex items-center gap-3 text-sm text-gray-500 border-t border-gray-200 pt-4">
                <div>
                  <p class="font-semibold text-gray-900">{article.author}</p>
                  <p class="text-xs">{article.role}</p>
                </div>
                <span class="text-gray-300">&middot;</span>
                <p>{article.date}</p>
                <span class="text-gray-300">&middot;</span>
                <p>{article.readTime}</p>
              </div>
            </a>
          ))}
        </div>

        <!-- Empty state -->
        <div id="articles-empty" class="hidden text-center py-16 text-gray-400">
          <p class="text-lg font-medium mb-1">No articles match that search.</p>
          <p class="text-sm">Try a different term or <button class="text-[hsl(24,95%,53%)] hover:underline" onclick="document.getElementById('article-search').value='';window.__articleFilter()">clear the search</button>.</p>
        </div>

        <div class="mt-12 text-center text-gray-500 text-sm" id="articles-coming-soon">
          More articles coming soon.
        </div>
      </div>
    </section>
  </main>
</BaseLayout>

<style>
  .tag-chip {
    background: white;
    color: #6b7280;
    border-color: #d1d5db;
  }
  .tag-chip:hover {
    border-color: hsl(24, 95%, 53%);
    color: hsl(24, 95%, 53%);
  }
  .tag-chip.active {
    background: hsl(24, 95%, 53%);
    color: white;
    border-color: hsl(24, 95%, 53%);
  }

  :global(body.bhq-dark-shell) .tag-chip {
    background: transparent;
    color: #9ca3af;
    border-color: #374151;
  }
  :global(body.bhq-dark-shell) .tag-chip:hover {
    border-color: hsl(24, 95%, 53%);
    color: hsl(24, 95%, 53%);
  }
  :global(body.bhq-dark-shell) .tag-chip.active {
    background: hsl(24, 95%, 53%);
    color: white;
    border-color: hsl(24, 95%, 53%);
  }
</style>

<script>
  (function () {
    const searchInput = document.getElementById('article-search') as HTMLInputElement | null;
    const chips = document.querySelectorAll<HTMLButtonElement>('.tag-chip');
    const cards = document.querySelectorAll<HTMLElement>('.article-card');
    const emptyState = document.getElementById('articles-empty');
    const countLabel = document.getElementById('articles-count-label');
    const comingSoon = document.getElementById('articles-coming-soon');

    let activeTag = 'all';
    let searchQuery = '';

    function filter() {
      let visible = 0;

      cards.forEach(card => {
        const tagMatch = activeTag === 'all' || card.dataset.tag === activeTag;
        const q = searchQuery.trim().toLowerCase();
        const textMatch = !q
          || (card.dataset.title ?? '').includes(q)
          || (card.dataset.excerpt ?? '').includes(q)
          || (card.dataset.tag ?? '').toLowerCase().includes(q);

        const show = tagMatch && textMatch;
        card.style.display = show ? '' : 'none';
        if (show) visible++;
      });

      if (emptyState) emptyState.classList.toggle('hidden', visible > 0);
      if (comingSoon) comingSoon.style.display = visible === 0 ? 'none' : '';
      if (countLabel) {
        if (activeTag !== 'all' || searchQuery.trim()) {
          countLabel.textContent = visible === 1 ? '1 article' : `${visible} articles`;
        } else {
          countLabel.textContent = 'More Articles';
        }
      }
    }

    // Expose for the empty-state inline onclick
    (window as any).__articleFilter = filter;

    chips.forEach(chip => {
      chip.addEventListener('click', () => {
        activeTag = chip.dataset.tag ?? 'all';
        chips.forEach(c => {
          c.classList.toggle('active', c === chip);
          c.setAttribute('aria-pressed', c === chip ? 'true' : 'false');
        });
        filter();
      });
    });

    if (searchInput) {
      searchInput.addEventListener('input', () => {
        searchQuery = searchInput.value;
        filter();
      });
    }
  })();
</script>
