---
import BaseLayout from '../layouts/BaseLayout.astro';
import ReviewCard from '../components/ReviewCard.astro';
import { sortedTestimonials, sourceStats } from '../data/testimonials';

const breadcrumbs = [
  { name: 'Home', url: '/' },
  { name: 'Breeder Reviews', url: '/reviews' },
];

const reviews = sortedTestimonials();
const stats = sourceStats();
const ratingLines = stats.map(
  (s) => `${s.label}: ${s.average.toFixed(1)} average from ${s.count} ${s.count === 1 ? 'review' : 'reviews'}`,
);

const googleReviewUrl = 'https://g.page/r/Cax9mYrHclivEAI/review';
const appStoreUrl = 'https://apps.apple.com/us/app/breederhq/id6761625868';
---

<BaseLayout
  title="Breeder Reviews | BreederHQ"
  description="Read what breeders say about BreederHQ in their own words, from public reviews on the App Store and Google."
  breadcrumbs={breadcrumbs}
>
  <main>
    <header style="max-width:820px;margin:0 auto;padding:64px 20px 8px;text-align:center">
      <div style="font-family:'JetBrains Mono',monospace;font-size:11px;letter-spacing:.2em;color:#FF6A2C;margin-bottom:16px">REVIEWS</div>
      <h1 style="margin:0;font-size:clamp(32px,5vw,52px);line-height:1.08;font-weight:800;letter-spacing:-.025em;color:#EAF1FC">Breeder Reviews</h1>
      <p style="margin:18px auto 0;max-width:600px;font-size:17px;line-height:1.55;color:#AEC0DA">
        Public reviews from breeders who use BreederHQ, shown exactly as they posted them. Each one links back to where it was written.
      </p>
      <p style="margin:16px auto 0;font-size:14px;line-height:1.6;color:#8DA0BD">
        {ratingLines.map((line, i) => (<>{i > 0 && <span aria-hidden="true"> &middot; </span>}<span>{line}</span></>))}
      </p>
    </header>

    <section style="max-width:1120px;margin:0 auto;padding:36px 20px 20px" aria-label="All reviews">
      <div class="reviews-grid">
        {reviews.map((r) => <ReviewCard review={r} />)}
      </div>
    </section>

    <section style="max-width:760px;margin:0 auto;padding:40px 20px 80px;text-align:center">
      <h2 style="margin:0;font-size:clamp(24px,3.4vw,34px);line-height:1.15;font-weight:800;letter-spacing:-.02em;color:#EAF1FC">Share Your Experience</h2>
      <p style="margin:14px auto 0;max-width:520px;font-size:16px;line-height:1.55;color:#AEC0DA">
        Using BreederHQ? A review on Google or the App Store helps other breeders decide.
      </p>
      <div style="display:flex;flex-wrap:wrap;gap:12px;justify-content:center;margin-top:24px">
        <a href={googleReviewUrl} target="_blank" rel="noopener" style="display:inline-flex;align-items:center;gap:8px;padding:14px 22px;border-radius:12px;font-weight:600;font-size:15px;color:#0A0F1A;background:linear-gradient(150deg,#FF6A2C,#FF9A3C);text-decoration:none">Leave A Review<span class="sr-only"> on Google (opens in a new tab)</span></a>
        <a href={appStoreUrl} target="_blank" rel="noopener" style="display:inline-flex;align-items:center;gap:8px;padding:14px 22px;border-radius:12px;font-weight:600;font-size:15px;color:#EAF1FC;border:1px solid rgba(255,255,255,.16);text-decoration:none">Review On The App Store<span class="sr-only"> (opens in a new tab)</span></a>
      </div>
    </section>
  </main>
</BaseLayout>

<style>
  .reviews-grid {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 18px;
    align-items: start;
  }
  @media (max-width: 760px) {
    .reviews-grid {
      grid-template-columns: minmax(0, 1fr);
    }
  }
</style>
