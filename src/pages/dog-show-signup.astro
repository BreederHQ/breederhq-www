---
// Semi-private booth signup page. Excluded from sitemap and bot crawl.
// Form submits to /api/contact which emails support@breederhq.com.
export const prerender = true;

const showName = "Capital City Cluster 2026";
const stack = [
  { title: "Full data migration", solves: "Spreadsheets, PedFast exports, photos of paper records. All of it loaded before session one.", value: "$599" },
  { title: "Three live founder-led sessions", solves: "Not videos. The founder on Zoom with you. Storefront live, breeding program built, workflow reviewed.", value: "$450" },
  { title: "Embed widget installation", solves: "Walked through the snippet together. Your own site's available animals page updates itself from then on.", value: "$149" },
  { title: "30-day follow-up call", solves: "Four weeks later the founder checks back in. Rules firing, nothing stuck, questions answered.", value: "$99" },
  { title: "12 months of BreederHQ", solves: "The Launch Pro tier for a full year. No monthly billing to second-guess.", value: "$1,499" },
  { title: "Priority support for 90 days", solves: "Your tickets go to the front of the queue, answered within four business hours.", value: "$149" },
];
---

<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <title>Free Year of BreederHQ: Booth Signup</title>
  <meta name="robots" content="noindex, nofollow" />
  <link rel="icon" href="/favicon.png" type="image/png" />
  <link rel="manifest" href="/dog-show-signup.webmanifest" />
  <meta name="theme-color" content="#0a0a0a" />
  <style>
    *, *::before, *::after { box-sizing: border-box; margin: 0; padding: 0; }

    :root {
      --brand-orange: 24 95% 53%;
      --brand-orange-light: 30 100% 65%;
      --primary: 0 0% 95%;
      --secondary: 0 0% 65%;
      --muted-foreground: 0 0% 50%;
      --surface: 0 0% 10%;
      --surface-strong: 0 0% 14%;
      --hairline: 0 0% 20%;
      --danger: 0 72% 60%;
      --success: 142 70% 50%;
      --gradient-page: linear-gradient(160deg, #16181d 0%, #0e1013 55%, #131519 100%);
      --gradient-accent: linear-gradient(90deg, hsl(30 100% 68%), hsl(24 95% 53%));
      --shadow-card: 0 4px 24px rgba(0,0,0,.45);
      --font-sans: -apple-system, BlinkMacSystemFont, "Segoe UI", system-ui, sans-serif;
      --font-display: "Georgia", "Times New Roman", serif;
      --font-mono: "SF Mono", "Fira Code", "Consolas", monospace;
      --font-label: -apple-system, BlinkMacSystemFont, "Segoe UI", system-ui, sans-serif;
    }

    html, body {
      min-height: 100vh;
      background: #121316;
      font-family: var(--font-sans);
      color: hsl(var(--primary));
      -webkit-font-smoothing: antialiased;
    }

    a { color: hsl(var(--brand-orange)); text-decoration: none; }
    a:hover { color: hsl(var(--brand-orange-light)); }
    input, button, select { font-family: var(--font-sans); }
    input::placeholder { color: hsl(0 0% 45%); }

    @keyframes bhqRise {
      from { opacity: 0; transform: translateY(10px); }
      to { opacity: 1; transform: none; }
    }
    @keyframes bhqGlow {
      0%, 100% { box-shadow: 0 0 0 0 hsl(var(--brand-orange) / .35); }
      50% { box-shadow: 0 0 0 14px hsl(var(--brand-orange) / 0); }
    }

    /* Screens */
    .screen { display: none; }
    .screen.active { display: block; }

    /* Offer screen */
    #screen-offer {
      max-width: 1120px;
      margin: 0 auto;
      padding: clamp(24px, 4vw, 56px) clamp(20px, 4vw, 48px) 40px;
      animation: bhqRise .4s ease both;
    }

    .offer-header {
      display: flex;
      align-items: center;
      justify-content: space-between;
      gap: 20px;
      flex-wrap: wrap;
      margin-bottom: clamp(20px, 3vh, 32px);
    }

    .offer-hero-row {
      display: flex;
      align-items: flex-start;
      gap: clamp(20px, 3vw, 36px);
      margin-bottom: clamp(16px, 2.5vh, 28px);
    }

    .offer-hero-logo {
      flex-shrink: 0;
      width: clamp(80px, 10vw, 130px);
      height: auto;
      display: block;
      margin-top: .08em;
    }

    .offer-hero-text {
      min-width: 0;
    }

    .show-badge {
      display: flex;
      align-items: center;
      gap: 10px;
      padding: 9px 16px;
      border-radius: 999px;
      background: hsl(var(--brand-orange) / .12);
      border: 1px solid hsl(var(--brand-orange) / .35);
    }

    .show-badge-dot {
      width: 7px;
      height: 7px;
      border-radius: 50%;
      background: hsl(var(--brand-orange));
      animation: bhqGlow 2.4s ease-in-out infinite;
    }

    .show-badge-label {
      font-family: var(--font-label);
      text-transform: uppercase;
      letter-spacing: .14em;
      font-size: clamp(10px, 1.1vw, 12px);
      font-weight: 600;
      color: hsl(var(--brand-orange-light));
    }

    .eyebrow {
      font-family: var(--font-label);
      text-transform: uppercase;
      letter-spacing: .16em;
      font-size: clamp(16.5px, 1.8vw, 19.5px);
      color: hsl(var(--secondary));
      margin-bottom: 16px;
    }

    h1.hero {
      font-family: var(--font-display);
      font-size: clamp(40px, 6.5vw, 82px);
      line-height: 1.0;
      letter-spacing: -.025em;
      font-weight: 700;
      margin: 0;
    }

    .hero-body {
      font-size: clamp(17px, 2vw, 22px);
      line-height: 1.5;
      color: hsl(var(--secondary));
      margin: clamp(14px, 2vh, 22px) 0 0;
      max-width: 860px;
    }

    .pro-pill {
      display: inline-flex;
      align-items: center;
      gap: 6px;
      padding: 2px 11px 3px;
      border-radius: 999px;
      background: rgb(245 158 11 / .15);
      border: 1px solid rgb(245 158 11 / .55);
      box-shadow: 0 0 8px rgb(245 158 11 / .2);
      color: #f59e0b;
      font-size: .82em;
      font-weight: 600;
      letter-spacing: .01em;
      white-space: nowrap;
      vertical-align: baseline;
    }

    .value-row {
      display: flex;
      flex-wrap: wrap;
      align-items: flex-start;
      gap: clamp(14px, 2.4vw, 32px);
      margin-top: clamp(24px, 3.5vh, 34px);
    }

    .value-col-label {
      font-family: var(--font-label);
      text-transform: uppercase;
      letter-spacing: .14em;
      font-size: 11px;
      font-weight: 600;
      color: hsl(var(--secondary));
      margin-bottom: 6px;
    }

    .value-big {
      font-family: var(--font-display);
      font-size: clamp(34px, 4.6vw, 52px);
      line-height: 1;
      font-weight: 700;
      letter-spacing: -.03em;
    }

    @media (max-width: 540px) {
      .value-divider { display: none; }
      .value-row { justify-content: center; text-align: center; }
    }

    .value-divider {
      width: 1px;
      align-self: stretch;
      background: hsl(var(--hairline));
    }

    .offer-grid {
      display: grid;
      grid-template-columns: repeat(auto-fit, minmax(320px, 1fr));
      gap: clamp(20px, 3vw, 32px);
      align-items: start;
      margin-top: clamp(32px, 5vh, 56px);
    }

    /* Stack card */
    .stack-card {
      background: linear-gradient(180deg, hsl(var(--surface) / .92), hsl(var(--surface) / .72));
      backdrop-filter: blur(12px);
      border: 1px solid hsl(var(--hairline));
      border-radius: 14px;
      box-shadow: var(--shadow-card), inset 0 1px 0 rgba(255,255,255,.04);
      overflow: hidden;
    }

    .stack-card-header {
      padding: 20px 22px;
      border-bottom: 1px solid hsl(var(--hairline));
    }

    .stack-card-header h2 {
      font-family: var(--font-label);
      text-transform: uppercase;
      letter-spacing: .14em;
      font-size: 12px;
      font-weight: 600;
      color: hsl(var(--secondary));
      margin: 0;
    }

    .stack-row {
      display: flex;
      align-items: baseline;
      gap: 14px;
      padding: 15px 22px;
      border-bottom: 1px solid hsl(var(--hairline) / .6);
    }

    .stack-row-title {
      font-size: clamp(15px, 1.6vw, 17px);
      font-weight: 600;
      letter-spacing: -.01em;
      margin-bottom: 3px;
    }

    .stack-row-desc {
      font-size: clamp(13px, 1.4vw, 14px);
      line-height: 1.45;
      color: hsl(var(--muted-foreground));
    }

    .stack-row-value {
      font-family: var(--font-mono);
      font-size: clamp(14px, 1.5vw, 16px);
      font-weight: 600;
      color: hsl(var(--secondary));
      text-decoration: line-through;
      text-decoration-color: hsl(var(--brand-orange) / .7);
      white-space: nowrap;
    }

    .stack-row-included {
      font-family: var(--font-label);
      text-transform: uppercase;
      letter-spacing: .1em;
      font-size: 10px;
      font-weight: 600;
      color: hsl(var(--brand-orange-light));
      margin-top: 4px;
    }

    .stack-footer {
      padding: 20px 22px;
      background: hsl(var(--surface-strong) / .6);
    }

    .stack-total-row {
      display: flex;
      align-items: baseline;
      justify-content: space-between;
      gap: 14px;
    }

    .stack-total-label {
      font-family: var(--font-label);
      text-transform: uppercase;
      letter-spacing: .14em;
      font-size: 12px;
      font-weight: 600;
      color: hsl(var(--secondary));
    }

    .stack-total-amount {
      font-family: var(--font-mono);
      font-size: clamp(19px, 2.2vw, 23px);
      font-weight: 700;
    }

    .stack-your-cost {
      margin-top: 12px;
      padding-top: 12px;
      border-top: 1px solid hsl(var(--hairline));
    }

    /* CTA card */
    .cta-col {
      display: flex;
      flex-direction: column;
      gap: 20px;
      position: sticky;
      top: 24px;
    }

    .cta-card {
      background: linear-gradient(180deg, hsl(var(--surface) / .92), hsl(var(--surface) / .72));
      backdrop-filter: blur(12px);
      border: 1px solid hsl(var(--brand-orange) / .3);
      border-radius: 14px;
      box-shadow: var(--shadow-card), inset 0 1px 0 rgba(255,255,255,.04);
      padding: clamp(24px, 3vw, 32px);
      text-align: center;
    }

    .cta-plan-badge {
      display: inline-flex;
      align-items: center;
      gap: 8px;
      padding: 7px 16px 8px;
      border-radius: 999px;
      background: rgb(245 158 11 / .15);
      border: 1px solid rgb(245 158 11 / .55);
      box-shadow: 0 0 10px rgb(245 158 11 / .2);
      margin-bottom: 16px;
    }

    .cta-plan-dot {
      width: 6px;
      height: 6px;
      border-radius: 50%;
      background: #f59e0b;
    }

    .cta-plan-name {
      font-size: 14px;
      font-weight: 600;
      letter-spacing: .01em;
      color: #f59e0b;
      white-space: nowrap;
    }

    .cta-plan-period {
      font-family: var(--font-label);
      text-transform: uppercase;
      letter-spacing: .1em;
      font-size: 10px;
      font-weight: 600;
      color: rgb(245 158 11 / .8);
    }

    .cta-price-label {
      font-family: var(--font-label);
      text-transform: uppercase;
      letter-spacing: .14em;
      font-size: 12px;
      font-weight: 600;
      color: hsl(var(--secondary));
    }

    .cta-price {
      font-family: var(--font-display);
      font-size: clamp(56px, 8vw, 86px);
      line-height: 1;
      font-weight: 700;
      letter-spacing: -.03em;
      margin: 10px 0 6px;
      background: var(--gradient-accent);
      -webkit-background-clip: text;
      background-clip: text;
      color: transparent;
    }

    .cta-body {
      font-size: clamp(14px, 1.5vw, 16px);
      line-height: 1.5;
      color: hsl(var(--muted-foreground));
      margin-bottom: 8px;
    }

    .cta-sub {
      font-size: clamp(13px, 1.4vw, 14px);
      color: hsl(var(--secondary));
      margin-bottom: 24px;
    }

    .btn-primary {
      display: block;
      width: 100%;
      height: 64px;
      background: var(--gradient-accent);
      color: #fff;
      border: none;
      border-radius: 10px;
      font-size: 19px;
      font-weight: 600;
      cursor: pointer;
      transition: opacity .15s;
    }
    .btn-primary:hover { opacity: .9; }
    .btn-primary:disabled { opacity: .5; cursor: not-allowed; }

    .btn-secondary {
      display: inline-block;
      height: 56px;
      padding: 0 32px;
      background: hsl(var(--surface-strong));
      color: hsl(var(--primary));
      border: 1px solid hsl(var(--hairline));
      border-radius: 8px;
      font-size: 17px;
      font-weight: 600;
      cursor: pointer;
      transition: background .15s;
    }
    .btn-secondary:hover { background: hsl(0 0% 18%); }

    .btn-back {
      min-height: 44px;
      padding: 0 16px;
      background: transparent;
      border: 1px solid hsl(var(--hairline));
      border-radius: 6px;
      color: hsl(var(--secondary));
      font-size: 14px;
      cursor: pointer;
      transition: background .2s, color .2s;
    }
    .btn-back:hover {
      background: hsl(0 0% 100% / .05);
      color: hsl(var(--primary));
    }

    .cta-hint {
      font-size: 13px;
      color: hsl(var(--muted-foreground));
      margin-top: 14px;
    }

    .cta-guarantee {
      margin-top: 22px;
      padding-top: 20px;
      border-top: 1px solid hsl(var(--hairline));
      text-align: left;
    }

    .cta-guarantee-label {
      font-family: var(--font-label);
      text-transform: uppercase;
      letter-spacing: .14em;
      font-size: 11px;
      font-weight: 600;
      color: hsl(var(--secondary));
      margin-bottom: 8px;
    }

    .cta-guarantee p {
      font-size: clamp(13.5px, 1.45vw, 15px);
      line-height: 1.5;
      color: hsl(var(--secondary));
    }

    .scout-hint {
      display: flex;
      gap: 14px;
      align-items: center;
      padding: 16px 18px;
      background: hsl(var(--surface-strong) / .5);
      border: 1px solid hsl(var(--hairline));
      border-radius: 12px;
    }

    .scout-hint p {
      font-size: clamp(13px, 1.4vw, 14.5px);
      line-height: 1.5;
      color: hsl(var(--secondary));
    }

    /* Form screen */
    #screen-form {
      min-height: 100vh;
      align-items: center;
      justify-content: center;
      padding: clamp(20px, 4vw, 48px);
    }
    #screen-form.active { display: flex; }

    .form-wrap {
      width: 100%;
      max-width: 620px;
      animation: bhqRise .35s ease both;
    }

    .form-header {
      display: flex;
      align-items: center;
      justify-content: space-between;
      margin-bottom: 26px;
    }

    .form-card {
      background: linear-gradient(180deg, hsl(var(--surface) / .94), hsl(var(--surface) / .74));
      backdrop-filter: blur(12px);
      border: 1px solid hsl(var(--hairline));
      border-radius: 14px;
      box-shadow: var(--shadow-card), inset 0 1px 0 rgba(255,255,255,.04);
      padding: clamp(24px, 4vw, 38px);
    }

    .form-card h1 {
      font-family: var(--font-display);
      font-size: clamp(28px, 4vw, 38px);
      line-height: 1.1;
      letter-spacing: -.02em;
      font-weight: 700;
      margin: 0 0 10px;
    }

    .form-card > p {
      font-size: clamp(15px, 1.7vw, 17px);
      line-height: 1.5;
      color: hsl(var(--secondary));
      margin: 0 0 28px;
    }

    .fields { display: flex; flex-direction: column; gap: 18px; }

    .field label {
      display: block;
      font-family: var(--font-label);
      text-transform: uppercase;
      letter-spacing: .12em;
      font-size: 11.5px;
      font-weight: 600;
      color: hsl(var(--secondary));
      margin-bottom: 8px;
    }

    .field input {
      width: 100%;
      height: 58px;
      padding: 0 16px;
      font-size: 18px;
      color: hsl(var(--primary));
      background: hsl(var(--surface-strong));
      border: 1px solid hsl(var(--hairline));
      border-radius: 8px;
      outline: none;
      caret-color: hsl(var(--brand-orange));
      transition: border-color .15s, box-shadow .15s;
    }

    .field input:focus {
      border-color: hsl(var(--brand-orange));
      box-shadow: 0 0 0 2px hsl(var(--brand-orange) / .45);
    }

    .field input.error {
      border-color: hsl(var(--danger));
    }

    .form-error {
      display: none;
      margin-top: 18px;
      padding: 13px 16px;
      border-radius: 8px;
      background: hsl(var(--danger) / .12);
      border: 1px solid hsl(var(--danger) / .4);
      color: hsl(var(--danger));
      font-size: 15px;
    }

    .form-error.visible { display: block; }

    .form-submit-wrap { margin-top: 26px; }

    .form-note {
      font-size: 13.5px;
      line-height: 1.5;
      color: hsl(var(--muted-foreground));
      margin: 16px 0 0;
      text-align: center;
    }

    /* Thanks screen */
    #screen-thanks {
      min-height: 100vh;
      align-items: center;
      justify-content: center;
      padding: clamp(24px, 5vw, 56px);
      text-align: center;
    }
    #screen-thanks.active { display: flex; }

    .thanks-wrap {
      max-width: 640px;
      animation: bhqRise .4s ease both;
    }

    .thanks-wrap img {
      width: clamp(92px, 14vw, 132px);
      height: auto;
      margin: 0 auto 26px;
      display: block;
    }

    .thanks-wrap h1 {
      font-family: var(--font-display);
      font-size: clamp(34px, 5.4vw, 56px);
      line-height: 1.08;
      letter-spacing: -.02em;
      font-weight: 700;
      margin: 0 0 18px;
    }

    .thanks-wrap > p {
      font-size: clamp(17px, 2vw, 21px);
      line-height: 1.5;
      color: hsl(var(--secondary));
      margin: 0 0 32px;
    }

    .thanks-pill {
      display: inline-flex;
      align-items: center;
      gap: 12px;
      padding: 14px 22px;
      border-radius: 999px;
      background: hsl(var(--surface-strong) / .6);
      border: 1px solid hsl(var(--hairline));
    }

    .thanks-pill-dot {
      width: 8px;
      height: 8px;
      border-radius: 50%;
      background: hsl(var(--success));
    }

    .thanks-pill span:last-child {
      font-size: 15px;
      color: hsl(var(--secondary));
    }

    .thanks-cta {
      margin-top: 38px;
    }

    .thanks-countdown {
      font-size: 13px;
      color: hsl(var(--muted-foreground));
      margin-top: 14px;
    }
  </style>
</head>
<body style="background: var(--gradient-page);">

<!-- OFFER SCREEN -->
<div id="screen-offer" class="screen active">
  <div style="max-width:1120px;margin:0 auto;padding:clamp(24px,4vw,56px) clamp(20px,4vw,48px) 40px;animation:bhqRise .4s ease both">

    <div class="offer-header">
      <div class="eyebrow" style="margin-bottom:0">Show-weekend offer for breeders</div>
      <div class="show-badge">
        <span class="show-badge-dot"></span>
        <span class="show-badge-label">{showName}</span>
      </div>
    </div>

    <div style="max-width:1000px">
      <div class="offer-hero-row">
        <img src="/images/dogshow/logo-lockup.png" alt="BreederHQ" class="offer-hero-logo" />
        <div class="offer-hero-text">
          <h1 class="hero">One Free Year of Breeder<span style="color:hsl(var(--brand-orange))">HQ</span>.</h1>
        </div>
      </div>
      <p class="hero-body">
        Sign up at the booth this weekend and you get&nbsp;<span class="pro-pill">BreederHQ Launch Pro</span>&nbsp;entirely free for 12 months, your operational records moved in by hand, and three live sessions with the founder. You launch with your program fully up and running, ready to launch your breeding business to the next level.
      </p>
      <div class="value-row">
        <div>
          <div class="value-col-label">Software and setup included</div>
          <div class="value-big" style="text-decoration:line-through;text-decoration-thickness:.06em;text-decoration-color:hsl(var(--brand-orange) / .8)">$2,945</div>
        </div>
        <div class="value-divider"></div>
        <div>
          <div class="value-col-label">What you pay</div>
          <div class="value-big" style="color:hsl(var(--brand-orange-light))">Nothing</div>
        </div>
        <div class="value-divider"></div>
        <div style="flex:1 1 180px;min-width:0">
          <div class="value-col-label">Six pieces, all included</div>
          <div style="font-size:clamp(13px,1.4vw,15px);line-height:1.35;color:hsl(var(--secondary))">Migration, three live sessions, marketplace widget installation, 1 mo. check-in call, a full year, priority support</div>
        </div>
      </div>
    </div>

    <div class="offer-grid">

      <!-- Stack card -->
      <div class="stack-card">
        <div class="stack-card-header">
          <h2>Everything included, and what it normally costs</h2>
        </div>
        {stack.map(row => (
          <div class="stack-row">
            <div style="flex:1;min-width:0">
              <div class="stack-row-title">{row.title}</div>
              <div class="stack-row-desc">{row.solves}</div>
            </div>
            <div style="text-align:right;flex-shrink:0">
              <div class="stack-row-value">{row.value}</div>
              <div class="stack-row-included">Included</div>
            </div>
          </div>
        ))}
        <div class="stack-footer">
          <div class="stack-total-row">
            <div class="stack-total-label">Total value</div>
            <div class="stack-total-amount">$2,945</div>
          </div>
          <div class="stack-total-row stack-your-cost">
            <div class="stack-total-label" style="color:hsl(var(--brand-orange-light))">Your cost this weekend</div>
            <div class="stack-total-amount" style="color:hsl(var(--brand-orange-light))">$0</div>
          </div>
        </div>
      </div>

      <!-- CTA card -->
      <div class="cta-col">
        <div class="cta-card">
          <div style="display:flex;justify-content:center;margin-bottom:16px">
            <div class="cta-plan-badge">
              <span class="cta-plan-dot"></span>
              <span class="cta-plan-name">BreederHQ - Launch Pro</span>
              <span class="cta-plan-period">Annual</span>
            </div>
          </div>
          <div class="cta-price-label">YOUR PRICE - THIS WEEKEND ONLY</div>
          <div class="cta-price">$0</div>
          <p class="cta-body">
            BreederHQ Launch Pro alone runs <span style="text-decoration:line-through">$1,499</span> a year. With the concierge on-boarding stacked on top, you are getting
            <span style="color:hsl(var(--primary));font-weight:600">$2,945</span> of software and all the founder-led hands-on work for nothing.
          </p>
          <div class="cta-sub">Available at this booth for the length of the show only</div>
          <button class="btn-primary" id="btn-go-form">Claim My Free Year!</button>
          <div class="cta-hint">Takes about 30 seconds. Four fields.</div>
          <div class="cta-guarantee">
            <div class="cta-guarantee-label">The 30-day guarantee</div>
            <p>Your Storefront live and your first Breeding Program running within 30 days, or you pay nothing.</p>
          </div>
        </div>

        <div class="scout-hint">
          <img src="/images/dogshow/scout-wink.png" alt="" style="width:44px;height:44px;flex-shrink:0;object-fit:contain" />
          <p>Bring your records - in whatever format they exist today. Spreadsheets, genetics exports... even photos of a paper binder. We get everything moved over and loaded for you before our first call.</p>
        </div>
      </div>

    </div>
  </div>
</div>

<!-- FORM SCREEN -->
<div id="screen-form" class="screen">
  <div class="form-wrap">
    <div class="form-header">
      <img src="/images/dogshow/logo-lockup.png" alt="BreederHQ" style="height:76px;width:auto;display:block" />
      <button class="btn-back" id="btn-back">Back</button>
    </div>
    <div class="form-card">
      <h1>Claim Your Free Year</h1>
      <p>We will email you within five business days to schedule on-boarding. Phone is optional.</p>
      <form id="signup-form" novalidate>
        <div class="fields">
          <div class="field">
            <label for="f-name">Full name</label>
            <input id="f-name" type="text" autocomplete="off" autocapitalize="words" placeholder="Jamie Whitfield" />
          </div>
          <div class="field">
            <label for="f-kennel">Kennel or program name</label>
            <input id="f-kennel" type="text" autocomplete="off" autocapitalize="words" placeholder="Whitfield Ridge Retrievers" />
          </div>
          <div class="field">
            <label for="f-email">Email</label>
            <input id="f-email" type="email" inputmode="email" autocomplete="off" autocapitalize="none" autocorrect="off" placeholder="jamie@whitfieldridge.com" />
          </div>
          <div class="field">
            <label for="f-phone">Phone</label>
            <input id="f-phone" type="tel" inputmode="tel" autocomplete="off" placeholder="(555) 214-8890" />
          </div>
        </div>
        <div class="form-error" id="form-error"></div>
        <div class="form-submit-wrap">
          <button class="btn-primary" type="submit" id="btn-submit">Sign Me Up!</button>
        </div>
        <p class="form-note">This goes straight to the founders.<br />Only used to set up your account and book your sessions.</p>
      </form>
    </div>
  </div>
</div>

<!-- THANKS SCREEN -->
<div id="screen-thanks" class="screen">
  <div class="thanks-wrap">
    <img src="/images/dogshow/scout-thumbsup.png" alt="" />
    <h1 id="thanks-heading">You're in</h1>
    <p>Your free year is reserved. Watch for an email from the founder within two business days to pick a time for session one and hand off your records.</p>
    <div class="thanks-pill">
      <span class="thanks-pill-dot"></span>
      <span>Come grab a sticker before you go</span>
    </div>
    <div class="thanks-cta">
      <button class="btn-secondary" id="btn-next">Next breeder</button>
      <div class="thanks-countdown" id="countdown-label"></div>
    </div>
  </div>
</div>

<script>
  const SHOW_NAME = document.querySelector('.show-badge-label')?.textContent || 'Dog Show 2026';

  let countdownTimer: ReturnType<typeof setInterval> | null = null;

  function showScreen(id: string) {
    document.querySelectorAll('.screen').forEach(el => el.classList.remove('active'));
    const el = document.getElementById(id);
    if (el) {
      el.classList.add('active');
      window.scrollTo(0, 0);
    }
  }

  function startCountdown() {
    let secs = 20;
    const label = document.getElementById('countdown-label');
    if (label) label.textContent = `Resetting automatically in ${secs}s`;
    if (countdownTimer) clearInterval(countdownTimer);
    countdownTimer = setInterval(() => {
      secs--;
      if (label) label.textContent = `Resetting automatically in ${secs}s`;
      if (secs <= 0) {
        if (countdownTimer) clearInterval(countdownTimer);
        showScreen('screen-offer');
      }
    }, 1000);
  }

  function stopCountdown() {
    if (countdownTimer) clearInterval(countdownTimer);
    countdownTimer = null;
  }

  document.getElementById('btn-go-form')?.addEventListener('click', () => {
    stopCountdown();
    showScreen('screen-form');
    document.getElementById('f-name')?.focus();
  });

  document.getElementById('btn-back')?.addEventListener('click', () => {
    clearForm();
    showScreen('screen-offer');
  });

  function clearForm() {
    ['f-name', 'f-kennel', 'f-email', 'f-phone'].forEach(id => {
      const el = document.getElementById(id) as HTMLInputElement;
      if (el) el.value = '';
    });
    const errorEl = document.getElementById('form-error');
    if (errorEl) { errorEl.textContent = ''; errorEl.classList.remove('visible'); }
  }

  document.getElementById('btn-next')?.addEventListener('click', () => {
    stopCountdown();
    showScreen('screen-offer');
  });

  document.getElementById('signup-form')?.addEventListener('submit', async (e) => {
    e.preventDefault();

    const name = (document.getElementById('f-name') as HTMLInputElement)?.value.trim() || '';
    const kennel = (document.getElementById('f-kennel') as HTMLInputElement)?.value.trim() || '';
    const email = (document.getElementById('f-email') as HTMLInputElement)?.value.trim() || '';
    const phone = (document.getElementById('f-phone') as HTMLInputElement)?.value.trim() || '';

    const errorEl = document.getElementById('form-error');
    const submitBtn = document.getElementById('btn-submit') as HTMLButtonElement;

    function showError(msg: string) {
      if (errorEl) { errorEl.textContent = msg; errorEl.classList.add('visible'); }
    }

    errorEl?.classList.remove('visible');

    if (!name) return showError('Please add a name.');
    if (!email) return showError('Email is required so we can follow up with you.');
    if (!/^[^@\s]+@[^@\s]+\.[^@\s]+$/.test(email)) return showError('That email looks off. Mind checking it?');

    submitBtn.disabled = true;
    submitBtn.textContent = 'Submitting...';

    try {
      const res = await fetch('/api/contact', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({
          name,
          email: email || undefined,
          phone: phone || undefined,
          company: kennel || undefined,
          message: `Dog show booth signup at ${SHOW_NAME}. Kennel: ${kennel || 'not provided'}.`,
          source: 'dog_show_booth',
        }),
      });

      let data: { success: boolean; error?: string } = { success: false };
      if (res.ok) {
        try { data = await res.json(); } catch { /* empty body or non-JSON */ }
      }

      if (data.success) {
        const firstName = name.split(/\s+/)[0];
        const heading = document.getElementById('thanks-heading');
        if (heading) heading.textContent = firstName ? `You're in, ${firstName}` : "You're in";

        clearForm();
        showScreen('screen-thanks');
        startCountdown();
      } else {
        showError(data.error || 'Something went wrong. Please try again.');
      }
    } catch {
      showError('Something went wrong. Please try again.');
    } finally {
      submitBtn.disabled = false;
      submitBtn.textContent = 'Sign Me Up!';
    }
  });

  if ('serviceWorker' in navigator) {
    window.addEventListener('load', function() {
      navigator.serviceWorker.register('/sw.js', { scope: '/' });
    });
  }
</script>

</body>
</html>
