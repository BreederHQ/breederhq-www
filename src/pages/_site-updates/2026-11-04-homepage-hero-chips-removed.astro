---
// src/pages/_site-updates/2026-11-04-homepage-hero-chips-removed.astro
export const updateMeta = {
  date: '2026-11-04',
  title: 'Homepage hero floating chips removed',
  tags: ['homepage', 'hero', 'demo'],
};
---
<article class="border-l-4 border-[hsl(24,95%,53%)] pl-6">
  <h2 class="text-2xl font-bold text-gray-900 mb-1">November 4, 2026</h2>
  <p class="text-sm text-gray-500 mb-4">
    Removed the two floating labels from the homepage hero's product recording ("Marketplace Listing Synced" and
    "Buyer signed contract"). The lower one covered the text of the recording notice beneath the frame.
  </p>

  <div class="mb-4">
    <h3 class="font-semibold text-gray-900 mb-1">Pages updated</h3>
    <ul class="text-sm text-gray-600 list-disc pl-5 space-y-1">
      <li><a href="/" class="text-[hsl(24,95%,53%)] hover:underline">Homepage</a>: the hero recording frame no longer carries floating labels. The recording notice and the sandbox link are unchanged.</li>
      <li>The two float animations used only by those labels were removed from the global stylesheet.</li>
    </ul>
  </div>
</article>
