---
export const prerender = true;
---
<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <title>BreederHQ Booth</title>
  <meta name="robots" content="noindex, nofollow" />
  <link rel="manifest" href="/videos/booth-loop.webmanifest" />
  <meta name="theme-color" content="#000000" />
  <style>
    *, *::before, *::after { box-sizing: border-box; margin: 0; padding: 0; }
    html, body {
      width: 100%; height: 100%;
      background: #000;
      overflow: hidden;
    }
    video {
      position: fixed;
      inset: 0;
      width: 100%;
      height: 100%;
      object-fit: contain;
    }
    #tap {
      position: fixed;
      inset: 0;
      display: flex;
      align-items: center;
      justify-content: center;
      cursor: pointer;
      z-index: 10;
    }
    #tap svg {
      width: 80px;
      height: 80px;
      opacity: 0.7;
    }
    #tap.hidden { display: none; }
  </style>
</head>
<body>
  <video id="v" src="/videos/booth-loop.mp4" loop muted playsinline></video>
  <div id="tap">
    <svg viewBox="0 0 80 80" fill="white" xmlns="http://www.w3.org/2000/svg">
      <circle cx="40" cy="40" r="40" fill="rgba(255,255,255,0.15)"/>
      <polygon points="32,24 32,56 60,40" fill="white"/>
    </svg>
  </div>
<script is:inline>
  if ('serviceWorker' in navigator) {
    window.addEventListener('load', function() {
      navigator.serviceWorker.register('/sw.js', { scope: '/' });
    });
  }

  var v = document.getElementById('v');
  var tap = document.getElementById('tap');

  function startPlay() {
    v.play().then(function() {
      tap.classList.add('hidden');
    }).catch(function() {});
  }

  tap.addEventListener('click', startPlay);

  v.addEventListener('canplay', function() {
    startPlay();
  });
</script>
</body>
</html>
