---
// Public access page. Replaces the former three-tier pricing page.
//
// Public pricing is invite-only: there is no price list and no self-serve
// signup, because onboarding capacity is the real constraint. The page's one
// job is to explain that and capture an application. Anything that gives a
// visitor somewhere else to go — nav, footer links, a feature grid — competes
// with that single decision, so this page is a standalone document rather
// than a BaseLayout page.
//
// Kept at /pricing rather than a new /waitlist URL: ~180 internal links and
// an unknown number of external ones already point here, and a visitor
// arriving from a link labelled "Pricing" is exactly who the second paragraph
// is written for.
//
// The marketplace listing-fee schedule that used to live on this page now
// lives only in /pricing.md and /okf/pricing.md — still answerable, no longer
// competing with the application.
export const prerender = true;

// This page does not use BaseLayout (it deliberately carries no nav or footer),
// so everything BaseLayout would have brought has to be imported explicitly.
// Without the stylesheet every Tailwind class here resolves to nothing and the
// page ships as unstyled HTML; without Analytics there is no gtag, so the form's
// own conversion events fire into nothing and every application goes uncounted.
import '../../styles/global.css';
import PaidQuerySnapshot from '../../components/PaidQuerySnapshot.astro';
import Analytics from '../../components/Analytics.astro';
import TrackingInit from '../../components/TrackingInit.astro';

// All nine supported species. Cattle is excluded from the public marketplace
// buyer directory (see marketplaceData.ts SpeciesKey) but is supported and
// belongs here: this field asks a breeder what they breed, not what a buyer
// can browse.
const SPECIES = [
  { value: 'dogs', label: 'Dogs' },
  { value: 'cats', label: 'Cats' },
  { value: 'horses', label: 'Horses' },
  { value: 'goats', label: 'Goats' },
  { value: 'sheep', label: 'Sheep' },
  { value: 'cattle', label: 'Cattle' },
  { value: 'alpacas', label: 'Alpacas' },
  { value: 'llamas', label: 'Llamas' },
  { value: 'rabbits', label: 'Rabbits' },
  { value: 'multiple', label: 'Multiple species' },
  { value: 'other', label: 'Other' },
];

// ── Qualification fields ────────────────────────────────────────────────────
//
// What is being granted here is a complimentary lifetime subscription plus
// founder-led onboarding — a real cost, given to a small number of people. These
// questions exist to answer one thing: does this breeder justify that grant.
//
// Bands, never free numbers. A breeder answers a band instantly and accurately;
// an exact count invites hesitation and a guess, and a guess cannot be ranked
// against anyone else's guess. Bands also stay comparable when someone rounds
// generously.
//
// Every value is stored and shown to a human. Nothing here auto-rejects: a
// surprising answer is often a good breeder with an unusual operation, and the
// cost of wrongly turning one away is far higher than the cost of reading their
// application.

// Scale. Below two is the stated soft disqualifier — not enough operation to
// need the platform, or to produce a case study worth the onboarding hours.
const BREEDING_VOLUME = [
  { value: 'none_yet', label: 'None yet, planning my first' },
  { value: 'one_or_fewer', label: '1 or fewer per year' },
  { value: 'two_to_three', label: '2–3 per year' },
  { value: 'four_to_six', label: '4–6 per year' },
  { value: 'seven_plus', label: '7 or more per year' },
];

// WHO they place animals with, not whether they sell.
//
// A yes/no answer collapsed three genuinely different operations into one, and
// they need different halves of the product:
//
//   - Selling to the public is where the storefront, buyer waitlist, inquiries
//     and contracts all land. The fullest fit.
//   - Selling to other breeders is a real transaction with a real marketplace
//     listing; the audience is narrower, not absent.
//   - Keeping everything for show, competition or the farm is not a lesser fit,
//     it is a different one. Those breeders exercise the records, pedigrees and
//     title tracking that most operations never touch — which is exactly the
//     part of the system that benefits from someone using it in anger.
//
// Multi-select because most real operations are more than one of these, and
// forcing a single choice would throw away the distinction being asked for.
const PLACEMENT_MODES = [
  { value: 'public_pets', label: 'Pet or companion homes' },
  { value: 'other_breeders', label: 'Other breeders' },
  { value: 'working_sport', label: 'Working or sport homes' },
  { value: 'own_use', label: 'I keep them for show, competition or my own farm' },
  { value: 'not_yet', label: 'Not placing any yet' },
];

// The highest-signal question on the form. Someone already keeping records in a
// spreadsheet or a competitor's tool has proven two things at once: there is
// something real to migrate, and they are willing to use software. "Paper" or
// "in my head" is the profile that struggles most with a platform like this.
const RECORD_SOURCES = [
  { value: 'spreadsheet', label: 'Spreadsheets (Excel, Google Sheets)' },
  { value: 'breeding_software', label: 'Breeding software (another platform)' },
  { value: 'registry', label: 'A registry or studbook' },
  { value: 'notes_app', label: 'Notes app or documents' },
  { value: 'paper', label: 'Paper records or binders' },
  { value: 'memory', label: 'Mostly in my head' },
];

// Business maturity, and separately a practical fit signal: the embed widget
// only means something to a breeder who has a site to embed it in.
const WEBSITE_STATUS = [
  { value: 'yes_live', label: 'Yes, live now' },
  { value: 'building', label: 'Building one' },
  { value: 'social_only', label: 'Just social media' },
  { value: 'none', label: 'No' },
];

// How they found us, asked rather than inferred.
//
// UTM parameters only see people who arrived through a link we tagged. They are
// blind to the two channels that matter most here: a breeder who asked an
// assistant and was told about us, and a breeder another breeder told. Both are
// invisible in analytics and both are the ones worth knowing about.
//
// "An AI assistant" is broken out on its own rather than folded into search
// because the two behave nothing alike: one is a result you rank in, the other
// is an answer you are quoted in, and the work to earn each is different.
//
// Deliberately optional. It is the least important question on the form and the
// easiest to resent, and an answer given grudgingly is worse than no answer.
const REFERRAL_SOURCES = [
  { value: 'another_breeder', label: 'Another breeder told me' },
  { value: 'ai_assistant', label: 'An AI assistant (ChatGPT, Claude, Copilot)' },
  { value: 'web_search', label: 'A web search (Google, Bing)' },
  { value: 'show_or_event', label: 'At a show or event' },
  { value: 'facebook_group', label: 'A Facebook group' },
  { value: 'social', label: 'Instagram, YouTube or TikTok' },
  { value: 'breed_club', label: 'My breed club or registry' },
  { value: 'other', label: 'Somewhere else' },
];

const title = 'Join The BreederHQ Waitlist';
const description =
  'BreederHQ Launch is available to a limited number of founding members. Join the waitlist and we will reach out when a spot opens.';
const canonical = 'https://www.breederhq.com/pricing';

// Dark surfaces, matching the rest of the site rather than the cream this page
// used to render. hsl(24 95% 53%) is --color-accent from global.css, used
// literally so the focus ring is the site's orange and not Tailwind's amber,
// which is a visibly different hue against navy.
const inputClass =
  'min-h-[52px] w-full rounded-lg border border-white/12 bg-white/[0.04] px-4 py-3.5 text-base text-slate-100 placeholder:text-slate-400 focus:border-[hsl(24,95%,53%)] focus:bg-white/[0.07] focus:outline-none focus:ring-[3px] focus:ring-[hsl(24,95%,53%)]/25';
const labelClass =
  'text-[11.5px] font-semibold uppercase tracking-[0.1em] text-slate-400';
// One option row in a multi-select. Checked state carries the brand orange as
// an EDGE and a tint, never as a fill behind text.
const optionClass =
  'flex cursor-pointer items-center gap-3 rounded-lg border border-white/12 bg-white/[0.03] px-3.5 py-2.5 text-[15px] text-slate-200 transition hover:border-white/20 hover:bg-white/[0.06] has-[:checked]:border-[hsl(24,95%,53%)] has-[:checked]:bg-[hsl(24,95%,53%)]/10';

// The SMS consent statement, identified by a VERSION rather than carried as a
// string the browser submits.
//
// This page renders the wording; it does not report it. The platform holds the
// canonical text for this ID (api: src/services/sms-consent-versions.ts) and
// records the consent from its OWN copy. Anything the browser sends is a claim,
// and a claim about what a page displayed is not evidence of it — DevTools can
// edit the DOM, and a direct POST never renders the page at all.
//
// So the two must stay in step, and the ID is what keeps them honest: changing
// the sentence below WITHOUT minting a new ID on both sides means the record
// will say something different from what a breeder actually read. Change the
// wording and the ID together, or not at all.
//
// Scope is deliberately narrow. It names the Founders program and nothing else,
// so it cannot be read as authorising general marketing; widening what is sent
// later means a new version and asking again, not reinterpreting this one.
const SMS_CONSENT_VERSION = 'founders-sms-v1';
const SMS_CONSENT_TEXT =
  'I agree to receive text messages from BreederHQ about my Founders program application. Message and data rates may apply. Reply STOP to opt out at any time.';
---

<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <title>{title}</title>
  <meta name="description" content={description} />
  <link rel="canonical" href={canonical} />
  <link rel="icon" href="/favicon.png" type="image/png" />

  <meta property="og:type" content="website" />
  <meta property="og:title" content={title} />
  <meta property="og:description" content={description} />
  <meta property="og:url" content={canonical} />
  <meta name="twitter:card" content="summary_large_image" />
  <meta name="twitter:title" content={title} />
  <meta name="twitter:description" content={description} />

  <style is:global>
    /*
      NO `*{margin:0;padding:0}` reset here, deliberately.

      Tailwind's utilities live in `@layer utilities`, and an unlayered rule
      beats a layered one no matter how weak its selector. A universal reset
      declared in this block therefore overrode EVERY spacing utility on the
      page: `px-6`, `pt-6`, `pb-20` and `mx-auto` all computed to 0 while
      `max-w-6xl` and `gap-12` survived, because the reset does not name those
      properties. The result rendered as a styled page laid out flush against
      the viewport edge, which reads as "CSS partly loaded" rather than as a
      specificity problem, and it survived a build, a deploy and a review.

      Tailwind's preflight already normalises box-sizing and margins, in the
      right layer. It does not need help.
    */
    html { -webkit-text-size-adjust: 100%; }
    body { font-family: ui-sans-serif, system-ui, -apple-system, "Segoe UI", sans-serif; }
    .font-serif { font-family: Georgia, "Times New Roman", serif; }

    /*
      Required-field asterisk, on the DARK ground this page now renders on.

      hsl(0 72% 38%) was chosen when the page was cream, where it reads fine.
      Measured against #070C16 it is 2.62:1 — below the 4.5:1 AA bar for text,
      and the exact trap the platform's own styling rule warns about: no single
      red shade clears AA on both a light and a dark ground. This value measures
      5.17:1 on the same ground.
    */
    .text-edit-required { color: hsl(0 84% 60%); }
  </style>

  {/* Ordering is load-bearing and mirrors BaseLayout: the paid-query snapshot
      must run before Analytics, because gtag.js strips gclid from the URL via
      history.replaceState as soon as it loads. */}
  <PaidQuerySnapshot />
  <Analytics />
</head>
<body class="antialiased bhq-dark-shell" style="color-scheme: dark;">
  <!--
    bhq-dark-shell is what every other page gets from BaseLayout. This page
    skips BaseLayout to drop the nav and footer, and had silently dropped the
    shell with it - so the same utility classes that render dark navy
    everywhere else rendered cream here, and the waitlist looked like a
    different product from the site linking to it. Applied directly rather than
    by adopting BaseLayout, because the reason for skipping the layout still
    holds: nothing on this page should compete with the one decision.
  -->
  <div class="min-h-screen flex flex-col bg-[#070C16] text-slate-100 [background-image:radial-gradient(120%_80%_at_88%_-10%,rgba(249,115,22,0.14),transparent_60%)]">

    <header class="mx-auto w-full max-w-6xl flex items-center justify-between gap-4 px-6 py-6 sm:px-8">
      <a href="/" class="text-[19px] font-semibold tracking-tight no-underline">
        <span class="text-white">Breeder</span><span class="text-[hsl(24,95%,53%)]">HQ</span>
      </a>
      <span class="hidden text-[13px] uppercase tracking-[0.14em] text-slate-400 sm:block">Founding Members</span>
    </header>

    <!-- Application screen -->
    <main
      id="waitlist-screen"
      class="mx-auto grid w-full max-w-6xl flex-1 grid-cols-1 items-start gap-12 px-6 pb-20 pt-6 sm:px-8 lg:grid-cols-[1.05fr_0.95fr] lg:gap-24 lg:pt-10"
    >
      <section class="max-w-xl">
        <div class="mb-6 flex items-center gap-2.5">
          <span class="h-1.5 w-1.5 rounded-full bg-[hsl(24,95%,53%)] ring-4 ring-[hsl(24,95%,53%)]/20"></span>
          <span class="text-[11.5px] font-semibold uppercase tracking-[0.14em] text-slate-400">Invitation Only</span>
        </div>

        <h1 class="font-serif text-[2.4rem] font-normal leading-[1.05] tracking-tight text-white [text-wrap:pretty] sm:text-5xl lg:text-[3.75rem]">
          We are onboarding breeders<br class="hidden sm:block" />
          <em class="text-[hsl(24,95%,58%)] underline decoration-[hsl(24,95%,53%)]/45 underline-offset-[6px]">one at a time.</em>
        </h1>

        <p class="mt-7 max-w-[50ch] text-lg leading-relaxed text-slate-300 [text-wrap:pretty]">
          BreederHQ Launch is currently available to a limited number of founding
          members. We are bringing breeders onboard one at a time, so your setup is
          personal, founder-led and done properly.
        </p>
        <p class="mt-4 max-w-[50ch] text-lg leading-relaxed text-slate-300 [text-wrap:pretty]">
          Spots are limited and this round is close to full. That is why there is no
          price list on this page and no way to sign yourself up. Join the waitlist and
          we will reach out when a spot opens.
        </p>

        <hr class="mt-9 max-w-md border-white/10" />

        <p class="mt-5 max-w-[44ch] text-sm leading-relaxed text-slate-400">
          Running a large-scale operation or managing a breed registry?{" "}
          <a
            href="/contact"
            class="text-[hsl(24,95%,58%)] underline decoration-[hsl(24,95%,53%)]/35 underline-offset-2 hover:text-[hsl(24,95%,62%)] hover:decoration-[hsl(24,95%,53%)]/60"
          >Let&rsquo;s talk</a>.
        </p>
      </section>

      <section class="w-full max-w-md rounded-2xl border border-white/10 bg-white/[0.03] p-6 shadow-[0_1px_2px_rgba(28,25,23,0.04),0_12px_32px_-12px_rgba(28,25,23,0.10)] sm:p-8">
        <h2 class="text-base font-semibold tracking-tight text-white">Join The Waitlist</h2>
        <p class="mt-1 text-sm leading-relaxed text-slate-400">A person reads every one.</p>

        <div class="mt-4 flex items-start gap-3 rounded-xl border border-[hsl(24,95%,53%)]/30 bg-[hsl(24,95%,53%)]/[0.08] px-3.5 py-3">
          <svg class="mt-0.5 h-4 w-4 flex-none text-[hsl(24,95%,58%)]" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <circle cx="12" cy="12" r="9" /><path d="M12 7v5l3 2" />
          </svg>
          <p class="text-[13.5px] leading-relaxed text-[hsl(24,95%,62%)]">
            We set each breeder up personally, so we can only take a few at a time.
            The questions below tell us about your program.
          </p>
        </div>

        <form id="waitlist-form" novalidate class="mt-6 flex flex-col gap-[18px]">
          {/*
            Honeypot. Off-screen rather than `display:none`, because some bots
            skip hidden inputs but fill everything else.

            `hidden` (not aria-hidden) because a focusable control must never sit
            inside an aria-hidden subtree: that hides it from assistive tech
            while leaving it programmatically reachable, which is exactly the
            trap the rule exists to prevent. `hidden` removes it from the
            accessibility tree AND from focus, and the positioning keeps it in
            the layout for bots that check visibility.

            `name="nickname"` and `autocomplete="new-password"` keep password
            managers away: a field named "website" with a visible label is
            something Chrome and 1Password will happily autofill with a saved
            URL, and that autofill would look exactly like a bot.
          */}
          <div class="absolute left-[-9999px] top-auto h-px w-px overflow-hidden" hidden>
            <input
              type="text"
              id="waitlist-nickname"
              name="nickname"
              tabindex="-1"
              autocomplete="new-password"
              aria-label="Leave this field empty"
            />
          </div>

          {/*
            Three steps rather than one column. The questions did not get
            shorter, but a breeder can see the end of the one in front of her,
            which is the difference between answering and abandoning.

            The dots are a progress READOUT, not navigation: forward is gated on
            the visible step validating, so letting someone jump to step 3 would
            either skip that check or bounce them straight back. Back is always
            free — rereading what you already typed costs nothing.
          */}
          <div class="mb-1 flex items-center gap-2.5">
            <div class="flex items-center gap-1.5" id="waitlist-dots" role="presentation">
              <span data-dot="1" class="h-2 w-2 rounded-full bg-[hsl(24,95%,53%)] transition-all"></span>
              <span data-dot="2" class="h-2 w-2 rounded-full bg-white/20 transition-all"></span>
              <span data-dot="3" class="h-2 w-2 rounded-full bg-white/20 transition-all"></span>
            </div>
            <span class="text-[11.5px] font-medium uppercase tracking-[0.08em] text-slate-400" id="waitlist-step-label" aria-live="polite">
              Step 1 of 3 &middot; About You
            </span>
          </div>

          <fieldset data-step="1" tabindex="-1" class="m-0 flex flex-col gap-[18px] border-0 p-0">
            <legend class="sr-only">Step 1 of 3: About you</legend>

          <label class="flex flex-col gap-2">
            <span class={labelClass}>
              Name<span class="ml-px font-semibold text-edit-required" aria-hidden="true">*</span>
            </span>
            <input
              type="text" name="name" required aria-required="true" autocomplete="name"
              autocapitalize="words" maxlength="100" placeholder="Sarah Whitfield"
              class={inputClass}
            />
          </label>

          <label class="flex flex-col gap-2">
            <span class={labelClass}>
              Email<span class="ml-px font-semibold text-edit-required" aria-hidden="true">*</span>
            </span>
            <input
              type="email" name="email" required aria-required="true" autocomplete="email"
              inputmode="email" autocapitalize="none" spellcheck="false" maxlength="254"
              placeholder="you@kennelname.com"
              class={inputClass}
            />
          </label>

          <label class="flex flex-col gap-2">
            <span class={labelClass}>
              Kennel / Business Name<span class="ml-px font-semibold text-edit-required" aria-hidden="true">*</span>
            </span>
            <input
              type="text" name="kennel" required aria-required="true" autocomplete="organization"
              maxlength="120" placeholder="Whitfield Retrievers"
              class={inputClass}
            />
          </label>

          <label class="flex flex-col gap-2">
            <span class={labelClass}>
              Species<span class="ml-px font-semibold text-edit-required" aria-hidden="true">*</span>
            </span>
            <div class="relative">
              <select name="species" required aria-required="true" class={`appearance-none pr-11 ${inputClass}`}>
                <option value="" disabled selected>Select a species</option>
                {SPECIES.map((s) => <option value={s.value}>{s.label}</option>)}
              </select>
              <svg class="pointer-events-none absolute right-4 top-1/2 h-4 w-4 -translate-y-1/2 text-slate-400" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                <path d="m6 9 6 6 6-6" />
              </svg>
            </div>
          </label>

          {/*
            Qualification block. Six short answers, all banded except the last,
            so the whole form still reads as under a minute. These are what a
            person actually triages on; without them every applicant looks
            identical and the review is a coin toss.
          */}
          <hr class="my-1 border-white/10" />

          </fieldset>

          <fieldset data-step="2" tabindex="-1" class="m-0 flex flex-col gap-[18px] border-0 p-0">
            <legend class="sr-only">Step 2 of 3: Your program</legend>
          <label class="flex flex-col gap-2">
            <span class={labelClass}>
              Litters Or Breedings Per Year<span class="ml-px font-semibold text-edit-required" aria-hidden="true">*</span>
            </span>
            <div class="relative">
              <select name="breeding_volume" required aria-required="true" class={`appearance-none pr-11 ${inputClass}`}>
                <option value="" disabled selected>Select a range</option>
                {BREEDING_VOLUME.map((o) => <option value={o.value}>{o.label}</option>)}
              </select>
              <svg class="pointer-events-none absolute right-4 top-1/2 h-4 w-4 -translate-y-1/2 text-slate-400" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                <path d="m6 9 6 6 6-6" />
              </svg>
            </div>
          </label>

          <fieldset class="flex flex-col gap-2">
            <legend class={labelClass}>
              Where Your Animals Go<span class="ml-px font-semibold text-edit-required" aria-hidden="true">*</span>
            </legend>
            <p class="text-xs leading-relaxed text-slate-400">Select all that apply.</p>
            <div class="mt-0.5 grid grid-cols-1 gap-1.5">
              {PLACEMENT_MODES.map((o) => (
                <label class={optionClass}>
                  <input
                    type="checkbox" name="placement_modes" value={o.value}
                    class="h-4 w-4 flex-none rounded accent-[hsl(24,95%,53%)] focus:ring-2 focus:ring-[hsl(24,95%,53%)]/40"
                  />
                  <span>{o.label}</span>
                </label>
              ))}
            </div>
          </fieldset>

          <fieldset class="flex flex-col gap-2">
            <legend class={labelClass}>
              Where Your Records Live Today<span class="ml-px font-semibold text-edit-required" aria-hidden="true">*</span>
            </legend>
            <p class="text-xs leading-relaxed text-slate-400">Select all that apply.</p>
            <div class="mt-0.5 grid grid-cols-1 gap-1.5">
              {RECORD_SOURCES.map((o) => (
                <label class={optionClass}>
                  <input
                    type="checkbox" name="record_sources" value={o.value}
                    class="h-4 w-4 flex-none rounded accent-[hsl(24,95%,53%)] focus:ring-2 focus:ring-[hsl(24,95%,53%)]/40"
                  />
                  <span>{o.label}</span>
                </label>
              ))}
            </div>
          </fieldset>

          </fieldset>

          <fieldset data-step="3" tabindex="-1" class="m-0 flex flex-col gap-[18px] border-0 p-0">
            <legend class="sr-only">Step 3 of 3: A few last things</legend>
          <label class="flex flex-col gap-2">
            <span class={labelClass}>
              Do You Have A Business Website?<span class="ml-px font-semibold text-edit-required" aria-hidden="true">*</span>
            </span>
            <div class="relative">
              <select name="website_status" required aria-required="true" class={`appearance-none pr-11 ${inputClass}`}>
                <option value="" disabled selected>Select one</option>
                {WEBSITE_STATUS.map((o) => <option value={o.value}>{o.label}</option>)}
              </select>
              <svg class="pointer-events-none absolute right-4 top-1/2 h-4 w-4 -translate-y-1/2 text-slate-400" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                <path d="m6 9 6 6 6-6" />
              </svg>
            </div>
            {/*
              type="text", not type="url", deliberately.
              A breeder types "yourkennel.com" — which is what the placeholder
              asks for — and the browser's native url validation refuses it
              before any script runs, so the submit handler that adds the
              https:// never gets the chance. The field would simply refuse to
              submit with no useful explanation. inputmode keeps the right
              keyboard on a phone; normalizeUrl in the handler does the work.
            */}
            <input
              type="text" name="website_url" inputmode="url" autocapitalize="none"
              spellcheck="false" maxlength="200" placeholder="yourkennel.com"
              class={`mt-1 hidden ${inputClass}`} data-website-url
            />
            <span class="hidden text-xs leading-relaxed text-slate-400" data-website-hint>
              We will take a look before we talk.
            </span>
          </label>

          <label class="flex flex-col gap-2">
            <span class="flex items-baseline gap-2 text-[11.5px] font-semibold uppercase tracking-[0.1em] text-slate-400">
              What Made You Look For This Now?
              <span class="font-medium normal-case tracking-normal text-slate-400">Optional</span>
            </span>
            <textarea
              name="motivation" rows="3" maxlength="600"
              placeholder="Tell us what is taking up your time right now."
              class={`min-h-[92px] resize-y py-3 ${inputClass}`}
            ></textarea>
          </label>

          <hr class="my-1 border-white/10" />

          <label class="flex flex-col gap-2">
            <span class="flex items-baseline gap-2 text-[11.5px] font-semibold uppercase tracking-[0.1em] text-slate-400">
              How Did You Hear About Us?
              <span class="font-medium normal-case tracking-normal text-slate-400">Optional</span>
            </span>
            <div class="relative">
              <select name="referral_source" class={`appearance-none pr-11 ${inputClass}`}>
                <option value="" selected>Select one</option>
                {REFERRAL_SOURCES.map((o) => <option value={o.value}>{o.label}</option>)}
              </select>
              <svg class="pointer-events-none absolute right-4 top-1/2 h-4 w-4 -translate-y-1/2 text-slate-400" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                <path d="m6 9 6 6 6-6" />
              </svg>
            </div>
            <input
              type="text" name="referral_detail" maxlength="120"
              placeholder="Who, or where?"
              class={`mt-1 hidden ${inputClass}`} data-referral-detail
            />
          </label>

          <label class="flex flex-col gap-2">
            <span class="flex items-baseline gap-2 text-[11.5px] font-semibold uppercase tracking-[0.1em] text-slate-400">
              Phone / WhatsApp
              <span class="font-medium normal-case tracking-normal text-slate-400">Optional</span>
            </span>
            <input
              type="tel" name="phone" autocomplete="tel" inputmode="tel" maxlength="25"
              placeholder="+1 555 0134"
              class={inputClass}
            />
            <span class="text-xs leading-relaxed text-slate-400">
              We default to US format. Start with <code class="font-mono">+</code> and your
              country code for international.
            </span>
          </label>

          {/*
            Unchecked by default and never required to submit.

            Both properties are the point rather than a style choice: agreement
            that was pre-ticked was never given, and agreement demanded as the
            price of joining the waitlist is not freely given either. A breeder
            who leaves this alone still applies normally and simply is not
            texted, which is why nothing in the submit path validates it.

            Rendered from SMS_CONSENT_TEXT so the words on screen and the words
            recorded are the same words.
          */}
          <label class="mt-1 flex cursor-pointer items-start gap-3 rounded-lg border border-white/12 bg-white/[0.03] px-3.5 py-3 text-[13px] leading-relaxed text-slate-300 transition hover:border-white/20 hover:bg-white/[0.06] has-[:checked]:border-[hsl(24,95%,53%)] has-[:checked]:bg-[hsl(24,95%,53%)]/10">
            {/*
              The version rides on the element itself so the submit handler can
              read it without the frontmatter constant being in its scope. It is
              an identifier, not the agreement: the platform resolves the wording
              from it, so a tampered value names an unknown version and records
              nothing rather than recording false terms.
            */}
            <input
              type="checkbox" name="sms_consent" value="yes"
              data-consent-version={SMS_CONSENT_VERSION}
              class="mt-0.5 h-4 w-4 flex-none rounded accent-[hsl(24,95%,53%)] focus:ring-2 focus:ring-[hsl(24,95%,53%)]/40"
            />
            <span>{SMS_CONSENT_TEXT}</span>
          </label>

          </fieldset>

          {/* Back is always available; forward validates the visible step. */}
          <div class="mt-1.5 flex items-center gap-3">
            <button
              type="button" id="waitlist-back" hidden
              class="min-h-[54px] shrink-0 rounded-lg border border-white/15 bg-white/[0.04] px-5 py-4 text-base font-medium text-slate-300 transition hover:border-white/25 hover:bg-white/[0.08] focus:outline-none focus-visible:ring-2 focus-visible:ring-[hsl(24,95%,53%)] focus-visible:ring-offset-2 focus-visible:ring-offset-[#070C16]"
            >Back</button>
            {/*
              Hidden in the MARKUP, revealed by renderStep(). Paging is the
              enhancement, so its control must not exist without the script that
              makes it work: without JavaScript this would sit beside the real
              submit button and do nothing when pressed.

              The reverse — the STEPS carrying `hidden` in the markup — is the
              bug this pairing exists to avoid. Measured on the built page with
              JavaScript disabled: steps 2 and 3 were unreachable and 9 of the 13
              fields were invisible, so a breeder in that state could not apply
              at all. The steps now ship visible and renderStep() hides them on
              first run.
            */}
            <button
              type="button" id="waitlist-next" hidden
              class="min-h-[54px] w-full rounded-lg border border-[hsl(24,95%,42%)] bg-[hsl(24,95%,53%)] px-5 py-4 text-base font-semibold text-white shadow-[inset_0_1px_0_rgba(255,255,255,0.22)] transition hover:-translate-y-px hover:brightness-105 focus:outline-none focus-visible:ring-2 focus-visible:ring-[hsl(24,95%,53%)] focus-visible:ring-offset-2 focus-visible:ring-offset-[#070C16] active:translate-y-0"
            >Continue</button>
          <button
            type="submit" id="waitlist-submit"
            class="min-h-[54px] w-full rounded-lg border border-[hsl(24,95%,40%)] bg-[hsl(24,95%,53%)] px-5 py-4 text-base font-semibold text-white shadow-[inset_0_1px_0_rgba(255,255,255,0.28),0_1px_2px_rgba(28,25,23,0.18)] transition hover:-translate-y-px hover:brightness-105 hover:shadow-[inset_0_1px_0_rgba(255,255,255,0.28),0_6px_16px_-6px_rgba(245,158,11,0.55)] focus:outline-none focus-visible:ring-2 focus-visible:ring-[hsl(24,95%,53%)] focus-visible:ring-offset-2 focus-visible:ring-offset-[#070C16] active:translate-y-0 active:shadow-[inset_0_2px_4px_rgba(0,0,0,0.22)] disabled:cursor-not-allowed disabled:opacity-70"
          >Join The Waitlist</button>
          </div>

          <p id="waitlist-error" class="hidden text-[13.5px] leading-relaxed text-red-400" role="alert"></p>

          <p class="mt-0.5 text-xs leading-relaxed text-slate-400">
            We use your details only to contact you about access. No newsletter, no sharing.
          </p>
        </form>
      </section>
    </main>

    <!-- Confirmation screen. Swapped in place rather than navigated to, so a
         failed submit never costs the visitor what they typed. -->
    <main id="waitlist-done" hidden class="flex flex-1 flex-col items-center justify-center px-6 py-24 text-center sm:px-8">
      <div class="mb-8 flex h-[52px] w-[52px] items-center justify-center rounded-full border border-[hsl(24,95%,53%)]/35 bg-[hsl(24,95%,53%)]/12">
        <svg class="h-5 w-5 text-[hsl(24,95%,58%)]" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <path d="M20 6 9 17l-5-5" />
        </svg>
      </div>
      <h1 id="waitlist-done-heading" class="font-serif text-[2.6rem] font-normal leading-[1.05] tracking-tight text-white sm:text-5xl lg:text-[4.25rem]">You&rsquo;re in</h1>
      <p class="mt-6 max-w-[34ch] text-lg leading-relaxed text-slate-300">
        You are on the waitlist. We will email you when a spot opens and set up your
        program with you personally.
      </p>
      <p class="mt-3.5 max-w-[38ch] text-sm leading-relaxed text-slate-400">
        Nothing else to do for now. You can close this page.
      </p>
    </main>

    <footer class="mx-auto w-full max-w-6xl px-6 pb-8 pt-6 text-xs text-slate-400 sm:px-8">
      &copy; 2026 BreederHQ
    </footer>
  </div>

  {/* Stores UTM parameters into sessionStorage. The submit handler reads them
      back from there, so without this an applicant arriving on a campaign link
      such as /pricing?utm_source=... would submit with no attribution. */}
  <TrackingInit />

  <script>
    import { trackFormStart, trackFormSubmit, getUTMParams } from '../../lib/tracking';
    import { createSubmissionKeyHolder } from '../../lib/submissionKey';
    import { AsYouType, parsePhoneNumberFromString, type CountryCode } from 'libphonenumber-js';

    const DEFAULT_COUNTRY: CountryCode = 'US';
    const FORM_ID = 'launch-waitlist';

    // Stamped when the script runs so the server can reject a submission that
    // arrived faster than a person could type one. Client-supplied and
    // therefore forgeable, which is fine: it is one cheap layer beside the
    // honeypot and the rate limit, not a gate on its own.
    const RENDERED_AT = Date.now();

    const form = document.getElementById('waitlist-form') as HTMLFormElement | null;
    if (form) {
      const screenEl = document.getElementById('waitlist-screen')!;
      const doneEl = document.getElementById('waitlist-done')!;
      const headingEl = document.getElementById('waitlist-done-heading')!;
      const btn = document.getElementById('waitlist-submit') as HTMLButtonElement;
      const errEl = document.getElementById('waitlist-error')!;
      const phoneInput = form.querySelector<HTMLInputElement>('input[name="phone"]');

      let formStarted = false;
      form.addEventListener('input', () => {
        if (formStarted) return;
        formStarted = true;
        trackFormStart(FORM_ID);
      }, { once: true });

      // Live phone formatting, matching ContactForm.astro. No "+" means US;
      // a leading "+" lets the library pick the country from the dial code.
      phoneInput?.addEventListener('input', () => {
        const raw = phoneInput.value.replace(/^\s+/, '');
        if (!raw) return;
        const atEnd = phoneInput.selectionStart === phoneInput.value.length;
        const formatted = raw.startsWith('+')
          ? new AsYouType().input(raw)
          : new AsYouType(DEFAULT_COUNTRY).input(raw);
        if (formatted !== phoneInput.value) {
          phoneInput.value = formatted;
          if (atEnd) phoneInput.setSelectionRange(formatted.length, formatted.length);
        }
      });

      function showError(msg: string) {
        errEl.textContent = msg;
        errEl.classList.remove('hidden');
      }

      // ── Paging ───────────────────────────────────────────────────────────
      //
      // Progressive enhancement, deliberately: every field is in the DOM from
      // first paint and `hidden` only hides the steps not being answered. With
      // JavaScript off the whole form renders as one column and still submits,
      // which is the behaviour it had before paging existed.
      const steps = Array.from(
        form.querySelectorAll<HTMLFieldSetElement>('fieldset[data-step]'),
      );
      const dots = Array.from(
        document.querySelectorAll<HTMLElement>('#waitlist-dots [data-dot]'),
      );
      const stepLabel = document.getElementById('waitlist-step-label')!;
      const backBtn = document.getElementById('waitlist-back') as HTMLButtonElement;
      const nextBtn = document.getElementById('waitlist-next') as HTMLButtonElement;
      const STEP_NAMES = ['About You', 'Your Program', 'A Few Last Things'];
      let step = 0;

      function renderStep() {
        steps.forEach((f, i) => {
          f.hidden = i !== step;
        });
        dots.forEach((d, i) => {
          // Passed and current both read as filled; ahead stays dim. A dot is a
          // readout, so it carries no click target and no focus stop.
          d.className =
            'h-2 w-2 rounded-full transition-all ' +
            (i <= step ? 'bg-[hsl(24,95%,53%)]' : 'bg-white/20');
        });
        stepLabel.textContent = `Step ${step + 1} of ${steps.length} · ${STEP_NAMES[step]}`;
        backBtn.hidden = step === 0;
        // The last step submits; the others advance. Swapping which button is
        // visible keeps one primary action on screen at a time.
        const last = step === steps.length - 1;
        nextBtn.hidden = last;
        btn.hidden = !last;
        errEl.classList.add('hidden');
      }

      /**
       * Is every required control on the VISIBLE step answered?
       *
       * Uses the browser's own validity plus an explicit check for the two
       * multi-selects, which are groups of checkboxes and so have no native
       * required state. Returns the message rather than throwing, so the caller
       * decides where it goes.
       */
      function validateStep(): string | null {
        const fs = steps[step];
        for (const el of Array.from(
          fs.querySelectorAll<HTMLInputElement | HTMLSelectElement | HTMLTextAreaElement>(
            'input, select, textarea',
          ),
        )) {
          if (el.type === 'checkbox') continue;
          if (!el.checkValidity()) {
            el.focus();
            const label = el.closest('label')?.querySelector('span')?.textContent ?? 'this field';
            return `Please complete ${label.replace('*', '').trim().toLowerCase()}.`;
          }
        }
        if (step === 1) {
          // A checkbox group has no native validity, so focus has to be moved
          // by hand — otherwise the message appears while focus is still on the
          // Continue button, past the group being complained about, and a
          // keyboard user has no way to reach what is wrong.
          const focusGroup = (name: string) =>
            fs.querySelector<HTMLInputElement>(`input[name="${name}"]`)?.focus();
          if (!fs.querySelector('input[name="placement_modes"]:checked')) {
            focusGroup('placement_modes');
            return 'Please tell us where your animals go. Choose "I keep them" if you are not placing any.';
          }
          if (!fs.querySelector('input[name="record_sources"]:checked')) {
            focusGroup('record_sources');
            return 'Please tell us where your records live today. "Mostly in my head" is a perfectly good answer.';
          }
        }
        return null;
      }

      /**
       * Put focus at the TOP of the step that just became visible.
       *
       * Without this, advancing leaves focus on Continue — which sits after
       * every control in the step it just revealed — so the next Tab leaves the
       * form entirely and a keyboard user never reaches the questions. The
       * fieldset takes a -1 tabindex so it can receive focus programmatically
       * without becoming a tab stop of its own.
       */
      function focusStep() {
        const fs = steps[step];
        const first = fs.querySelector<HTMLElement>(
          'input:not([type="hidden"]), select, textarea',
        );
        (first ?? fs).focus({ preventScroll: true });
      }

      nextBtn.addEventListener('click', () => {
        const problem = validateStep();
        if (problem) return showError(problem);
        step = Math.min(step + 1, steps.length - 1);
        renderStep();
        // Bring the top of the card into view. A breeder who has just filled
        // the bottom of a step would otherwise land mid-way down the next one.
        form.scrollIntoView({ behavior: 'smooth', block: 'start' });
        focusStep();
      });

      backBtn.addEventListener('click', () => {
        step = Math.max(step - 1, 0);
        renderStep();
        form.scrollIntoView({ behavior: 'smooth', block: 'start' });
        focusStep();
      });

      // Enter should advance rather than submit while a middle step is showing,
      // or a breeder answering step 1 would post a half-empty application.
      form.addEventListener('keydown', (e) => {
        const ke = e as KeyboardEvent;
        if (ke.key !== 'Enter') return;
        const target = ke.target as HTMLElement;
        // Only a TEXT ENTRY control. A textarea needs Enter for newlines, and a
        // BUTTON needs Enter to mean "press me" — intercepting it there made
        // Enter on Back advance the form instead of going back, which is the
        // opposite of what the control says it does. A select is left alone
        // too: Enter commits its open dropdown.
        const isTextEntry =
          target instanceof HTMLInputElement &&
          !['checkbox', 'radio', 'button', 'submit'].includes(target.type);
        if (!isTextEntry) return;
        if (step < steps.length - 1) {
          ke.preventDefault();
          nextBtn.click();
        }
      });

      renderStep();

      // Idempotency key for the platform's durable record. Held outside the
      // submit handler so a retry after a network failure replays the SAME key
      // and is recorded once; cleared only after a successful send, so a
      // deliberate second application correctly becomes a second submission.
      const submissionKeyHolder = createSubmissionKeyHolder();

      // The URL box only appears once a site actually exists. Asking for it
      // unconditionally makes four of every ten applicants stare at a field they
      // have to skip, which is exactly the friction this form cannot afford.
      const websiteSelect = form.querySelector<HTMLSelectElement>('select[name="website_status"]');
      const websiteUrl = form.querySelector<HTMLInputElement>('input[data-website-url]');
      const websiteHint = form.querySelector<HTMLElement>('[data-website-hint]');
      websiteSelect?.addEventListener('change', () => {
        const show = websiteSelect.value === 'yes_live' || websiteSelect.value === 'building';
        websiteUrl?.classList.toggle('hidden', !show);
        websiteHint?.classList.toggle('hidden', !show);
        if (!show && websiteUrl) websiteUrl.value = '';
      });

      // Only three answers have a useful follow-up. A referring breeder is worth
      // thanking and worth asking again; a show is worth knowing which one, since
      // that decides whether to go back. The rest need no second question and
      // asking one anyway would be friction for nothing.
      const REFERRAL_DETAIL_PROMPT: Record<string, string> = {
        another_breeder: 'Who should we thank?',
        show_or_event: 'Which show?',
        facebook_group: 'Which group?',
      };
      const referralSelect = form.querySelector<HTMLSelectElement>('select[name="referral_source"]');
      const referralDetail = form.querySelector<HTMLInputElement>('input[data-referral-detail]');
      referralSelect?.addEventListener('change', () => {
        const prompt = REFERRAL_DETAIL_PROMPT[referralSelect.value];
        referralDetail?.classList.toggle('hidden', !prompt);
        if (referralDetail) {
          if (prompt) referralDetail.placeholder = prompt;
          else referralDetail.value = '';
        }
      });

      /**
       * Accept what a breeder actually types. "yourkennel.com" is the normal
       * answer and `type="url"` rejects it outright, so the scheme is added
       * here rather than making someone guess why their own address is invalid.
       */
      function normalizeUrl(raw: string): string {
        const t = raw.trim();
        if (!t) return '';
        if (/^https?:\/\//i.test(t)) return t;
        // Anything already carrying a scheme is dropped rather than prefixed.
        // Prepending to `javascript:alert(1)` yields `https://javascript:...`,
        // which is harmless — it parses as nothing and the admin panel's
        // safeHref refuses it — but storing unparseable junk against an
        // applicant helps nobody. A real website address has no scheme here or
        // an http(s) one.
        if (/^[a-z][a-z0-9+-]*:(?!\d)/i.test(t)) return '';
        return `https://${t}`;
      }

      function firstName(full: string): string {
        const t = full.trim().replace(/\s+/g, ' ').split(' ')[0] || '';
        if (!t || !/\p{L}/u.test(t) || t.length > 18) return '';
        return t.charAt(0).toUpperCase() + t.slice(1);
      }

      form.addEventListener('submit', async (e) => {
        e.preventDefault();
        const els = form.elements as any;
        // Read the honeypot by query rather than through the untyped `els`
        // collection: a typo there would silently yield undefined and disable
        // the check without any error. `hidden` on an ancestor does not remove
        // a control from form.elements (verified in-browser), but this way a
        // rename cannot quietly turn the honeypot off.
        const honeypot =
          form.querySelector<HTMLInputElement>('input[name="nickname"]')?.value ?? '';
        const name = String(els.name.value || '').trim();
        const email = String(els.email.value || '').trim().toLowerCase();
        const kennel = String(els.kennel.value || '').trim();
        const species = String(els.species.value || '');
        const phoneRaw = String(els.phone.value || '').trim();

        const breedingVolume = String(els.breeding_volume?.value || '');
        const placementModes = Array.from(
          form.querySelectorAll<HTMLInputElement>('input[name="placement_modes"]:checked')
        ).map((el) => el.value);
        const websiteStatus = String(els.website_status?.value || '');
        const websiteUrlValue = normalizeUrl(String(websiteUrl?.value || ''));
        const motivation = String(els.motivation?.value || '').trim();
        const referralSource = String(els.referral_source?.value || '');
        const referralDetailValue = String(referralDetail?.value || '').trim();
        const recordSources = Array.from(
          form.querySelectorAll<HTMLInputElement>('input[name="record_sources"]:checked')
        ).map((el) => el.value);

        errEl.classList.add('hidden');
        if (!name) return showError('Please add your name.');
        if (!/^[^\s@]+@[^\s@.]+\.[^\s@]{2,}$/.test(email)) {
          return showError('Please check your email address.');
        }
        if (!kennel) return showError('Please add your kennel or business name.');
        if (!species) return showError('Please choose a species.');
        if (!breedingVolume) return showError('Please choose how many litters or breedings you average per year.');
        if (placementModes.length === 0) {
          return showError('Please tell us where your animals go. Choose "I keep them" if you are not placing any.');
        }
        if (recordSources.length === 0) {
          return showError('Please tell us where your records live today. "Mostly in my head" is a perfectly good answer.');
        }
        if (!websiteStatus) return showError('Please let us know whether you have a business website.');
        if (websiteStatus === 'yes_live' && !websiteUrlValue) {
          return showError('Please add your website address so we can take a look.');
        }
        if (websiteUrlValue) {
          try {
            const u = new URL(websiteUrlValue);
            if (!u.hostname.includes('.')) throw new Error('no tld');
          } catch {
            return showError('That website address does not look right. Try something like yourkennel.com');
          }
        }

        // Phone is optional, but a provided one must be real — the API
        // rejects an invalid number outright, so catch it here with a
        // message that says what to fix.
        let phoneE164: string | undefined;
        if (phoneRaw) {
          const parsed = parsePhoneNumberFromString(
            phoneRaw,
            phoneRaw.startsWith('+') ? undefined : DEFAULT_COUNTRY
          );
          if (!parsed || !parsed.isValid()) {
            return showError(
              'That does not look like a valid phone number. For international, start with + and your country code.'
            );
          }
          phoneE164 = parsed.number;
        }

        btn.disabled = true;
        btn.textContent = 'Sending…';

        // `kennel` maps to `company` and `species` to `interest`: /api/contact
        // builds its payload from a fixed field whitelist and silently drops
        // anything else, so a bespoke key here would lose the answer.
        const speciesLabel =
          form.querySelector<HTMLSelectElement>('select[name="species"]')
            ?.selectedOptions[0]?.textContent?.trim() || species;

        // Read the visible labels rather than the stored values: this text is
        // what a person reads in Slack and in the admin view, and "2–3 per year"
        // is answerable at a glance where "two_to_three" is not.
        function labelOf(selector: string, fallback: string): string {
          return (
            form.querySelector<HTMLSelectElement>(selector)?.selectedOptions[0]
              ?.textContent?.trim() || fallback
          );
        }
        function checkedLabels(name: string): string[] {
          return Array.from(
            form.querySelectorAll<HTMLInputElement>(`input[name="${name}"]:checked`)
          ).map((el) => el.closest('label')?.textContent?.trim() || el.value);
        }
        const recordLabels = checkedLabels('record_sources');
        const placementLabels = checkedLabels('placement_modes');

        // Composed into `message` because /api/contact carries a fixed field
        // whitelist and silently drops anything outside it. Until the platform
        // grows real columns for these, the transcript IS the record — so it is
        // written to be read by a person, not parsed.
        const qualification = [
          `Breedings/year: ${labelOf('select[name="breeding_volume"]', breedingVolume)}.`,
          `Animals go to: ${placementLabels.join('; ')}.`,
          `Records live in: ${recordLabels.join('; ')}.`,
          `Website: ${labelOf('select[name="website_status"]', websiteStatus)}${
            websiteUrlValue ? ` (${websiteUrlValue})` : ''
          }.`,
          referralSource
            ? `Heard about us: ${labelOf('select[name="referral_source"]', referralSource)}${
                referralDetailValue ? ` (${referralDetailValue})` : ''
              }.`
            : '',
          motivation ? `Why now: ${motivation}` : '',
        ]
          .filter(Boolean)
          .join(' ');

        const payload: Record<string, unknown> = {
          name,
          email,
          company: kennel,
          interest: species,
          message:
            `Launch waitlist application. Species: ${speciesLabel}. Kennel: ${kennel}. ` +
            qualification,
          source: 'launch_waitlist',
          submission_key: submissionKeyHolder.get(),
          // Bot checks. Both are read server-side; see /api/contact.
          website: honeypot,
          rendered_at: RENDERED_AT,
        };
        if (phoneRaw) {
          payload.phone = phoneRaw;
          payload.phone_e164 = phoneE164;
          // Consent travels WITH the number and only with it. Agreement to be
          // texted at a number nobody gave is not a permission, it is a claim
          // about nothing, and storing it would put a consent record on a lead
          // that can never be contacted anyway.
          //
          // Only the VERSION travels, never the sentence.
          //
          // An earlier draft read the wording out of the rendered label, on the
          // reasoning that doing so guaranteed "stored equals shown". It does
          // not: anything the browser sends is a claim, and the platform cannot
          // tell a claim about the rendered page apart from one typed into
          // DevTools or posted directly at the API. Sending the ID instead lets
          // the platform record from its own published copy, so the stored terms
          // can only ever be terms the product actually shipped.
          const consentBox = document.querySelector<HTMLInputElement>(
            'input[name="sms_consent"]'
          );
          const consentVersion = consentBox?.dataset.consentVersion;
          if (consentBox?.checked && consentVersion) {
            payload.sms_consent = true;
            payload.sms_consent_version = consentVersion;
          }
        }
        // Sent as its own field, not only inside the message text: the platform
        // resolves what the site is built on after the lead is saved, and that
        // needs a URL it can parse rather than one it has to find in prose.
        if (websiteUrlValue) payload.website_url = websiteUrlValue;
        // Its own field as well as the message text: attribution is something
        // you count, and counting means a column rather than prose. UTM params
        // cannot see a breeder who was told about us by another breeder or by an
        // assistant, which are the two answers most worth having.
        if (referralSource) {
          payload.referral_source = referralSource;
          if (referralDetailValue) payload.referral_detail = referralDetailValue;
        }
        // Structured as well as prose. The message text is what a person reads
        // in Slack; these are what the triage screen ranks on.
        payload.breeding_volume = breedingVolume;
        payload.placement_modes = placementModes;
        payload.record_sources = recordSources;
        payload.website_ownership = websiteStatus;

        const utm = getUTMParams();
        if (utm.source) payload.utm_source = utm.source;
        if (utm.medium) payload.utm_medium = utm.medium;
        if (utm.campaign) payload.utm_campaign = utm.campaign;
        if (utm.term) payload.utm_term = utm.term;
        if (utm.content) payload.utm_content = utm.content;

        try {
          const res = await fetch('/api/contact', {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify(payload),
          });

          // A rejected submission comes back 200 with { success: false }, so
          // res.ok alone would show the confirmation for a lead that was
          // never recorded.
          let data: { success?: boolean; error?: string } = {};
          try { data = await res.json(); } catch { /* empty or non-JSON body */ }

          if (!data.success) throw new Error(data.error || 'Submission failed');

          // Recorded. A later application from this page is a genuinely new
          // submission and must not replay this key.
          submissionKeyHolder.clear();

          trackFormSubmit(FORM_ID);

          const fn = firstName(name);
          headingEl.textContent = fn ? `You’re in, ${fn}` : 'You’re in';
          screenEl.hidden = true;
          doneEl.hidden = false;
          window.scrollTo(0, 0);
        } catch (err) {
          btn.disabled = false;
          btn.textContent = 'Join The Waitlist';
          showError(
            err instanceof Error && err.message && err.message !== 'Submission failed'
              ? err.message
              : 'Something went wrong sending that. Please try again, or email us at support@breederhq.com.'
          );
        }
      });
    }
  </script>
</body>
</html>
