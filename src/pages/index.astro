<BaseLayout
  title="Breeding Management Software | For 9 Species, One Account | BreederHQ"
  description="Breeding software for dogs, cats, horses, goats, sheep, cattle, alpacas, and rabbits. Pedigrees, health testing, and waitlists in one place. Access is invitation only."
  faqs={faqs}
  hideLogo={true}
>

<main>

<!-- ===== HERO ===== -->
<header id="top" style="position:relative;overflow:hidden;padding:78px 30px 40px">
  <div aria-hidden="true" style="position:absolute;inset:0;pointer-events:none;background:radial-gradient(720px 520px at var(--mx,64%) var(--my,26%),rgba(255,106,44,.20),transparent 60%),radial-gradient(900px 700px at 12% 8%,rgba(60,110,220,.14),transparent 55%)"></div>
  <div aria-hidden="true" style="position:absolute;inset:0;pointer-events:none;background-image:linear-gradient(rgba(255,255,255,.045) 1px,transparent 1px),linear-gradient(90deg,rgba(255,255,255,.045) 1px,transparent 1px);background-size:44px 44px;mask-image:radial-gradient(80% 70% at 50% 30%,#000,transparent 85%);animation:bhqGridDrift 9s linear infinite"></div>
  <div style="position:relative;max-width:1180px;margin:0 auto;display:grid;grid-template-columns:1.02fr 1.15fr;gap:44px;align-items:center" class="bhq-hero-grid">
    <!-- copy -->
    <div>
      <!-- Logo lockup -->
      <div style="display:flex;align-items:center;gap:14px;margin-bottom:24px">
        <!-- width/height are the asset's INTRINSIC ratio (147x128) so the browser
             reserves the right box and the mark does not shift as it loads. The CSS
             pins the height and lets width follow, matching the header's h-10 w-auto
             pattern - forcing a square on this 1.15:1 mark squashed the horse ~13%. -->
        <img src="/logo-icon.png" alt="" aria-hidden="true" width="147" height="128" style="display:block;height:64px;width:auto;object-fit:contain;filter:drop-shadow(0 0 16px rgba(255,106,44,.60))" />
        <span style="font-family:'Sora',system-ui,sans-serif;font-size:38px;font-weight:700;letter-spacing:-.025em;color:#EAF1FC">Breeder<span style="color:#FF6A2C">HQ</span></span>
      </div>
      <div style="display:inline-flex;align-items:center;gap:9px;padding:6px 12px;border-radius:999px;border:1px solid rgba(255,138,76,.28);background:rgba(255,106,44,.07);font-family:'JetBrains Mono',monospace;font-size:11px;letter-spacing:.16em;color:#FFB98C">
        <span style="width:6px;height:6px;border-radius:50%;background:#FF6A2C;box-shadow:0 0 10px #FF6A2C;animation:bhqPulse 2.4s ease-in-out infinite;flex-shrink:0"></span>
        SOFTWARE · MARKETPLACE · COMMUNITY
      </div>
      <h1 style="margin:20px 0 0;font-size:clamp(38px,5vw,64px);line-height:1.02;font-weight:800;letter-spacing:-.03em;color:#EAF1FC">
        The Operating System for <span style="background:linear-gradient(120deg,#FF6A2C,#FFB020 60%,#FF8A4C);-webkit-background-clip:text;background-clip:text;color:transparent">Modern Breeding Professionals</span>
      </h1>
      <p style="margin:22px 0 0;max-width:520px;font-size:18px;line-height:1.55;color:#AEC0DA">
        Run a more organized, profitable breeding program, without drowning in spreadsheets, paperwork, and scattered tools.
      </p>
      <div style="display:flex;flex-wrap:wrap;gap:13px;margin-top:30px">
        <a href="/pricing" style="display:inline-flex;align-items:center;gap:9px;padding:15px 24px;border-radius:12px;font-weight:600;font-size:15.5px;color:#0A0F1A;background:linear-gradient(150deg,#FF6A2C,#FF9A3C);box-shadow:0 10px 34px rgba(255,106,44,.42);text-decoration:none">Join The Waitlist <span style="font-size:17px">&#8594;</span></a>
        <a href="https://marketplace.breederhq.com" style="display:inline-flex;align-items:center;gap:9px;padding:15px 22px;border-radius:12px;font-weight:600;font-size:15.5px;color:#EAF1FC;border:1px solid rgba(255,255,255,.16);background:rgba(255,255,255,.03);text-decoration:none">Browse the Marketplace</a>
      </div>
      <div style="display:flex;flex-wrap:wrap;gap:8px 20px;margin-top:22px;font-family:'JetBrains Mono',monospace;font-size:11.5px;letter-spacing:.02em">
        <span style="color:#B9C8DE">invitation only</span><span style="color:#3C4C66">/</span>
        <span style="color:#B9C8DE">founder-led setup</span><span style="color:#3C4C66">/</span>
        <span style="color:#B9C8DE">never a % of your sales</span>
      </div>
    </div>
    <!-- command center mockup -->
    <div style="position:relative">
      <div style="position:relative;border-radius:16px;border:1px solid rgba(255,255,255,.11);background:linear-gradient(180deg,#0E1A2E,#0A1424);box-shadow:0 40px 90px -30px rgba(0,0,0,.8),0 0 0 1px rgba(255,138,76,.06);overflow:hidden">
        <!-- window chrome -->
        <div style="display:flex;align-items:center;gap:12px;padding:11px 14px;border-bottom:1px solid rgba(255,255,255,.07);background:rgba(255,255,255,.02)">
          <div style="display:flex;gap:6px">
            <span style="width:10px;height:10px;border-radius:50%;background:#33425C"></span>
            <span style="width:10px;height:10px;border-radius:50%;background:#33425C"></span>
            <span style="width:10px;height:10px;border-radius:50%;background:#33425C"></span>
          </div>
          <div style="flex:1;display:flex;align-items:center;gap:8px;padding:6px 11px;border-radius:8px;background:rgba(255,255,255,.04);border:1px solid rgba(255,255,255,.06);font-family:'JetBrains Mono',monospace;font-size:11px;color:#7E90AE">
            <span style="padding:1px 5px;border-radius:4px;background:rgba(255,255,255,.08);color:#B9C8DE">&#8984;K</span> Search animals, litters, buyers&hellip;
          </div>
          <span style="width:22px;height:22px;border-radius:50%;background:linear-gradient(150deg,#FF6A2C,#FF9A3C);flex-shrink:0"></span>
        </div>
        <div style="position:relative;padding-bottom:calc(77.4278% + 41px);height:0;width:100%;background:#0A1120">
          <iframe
            src="https://demo.arcade.software/Xmm9NUSi6yUGFrMbaaoV?embed&embed_mobile=tab&embed_desktop=inline&show_copy_link=true&autoplay=true&loop=true"
            title="BreederHQ interactive demo"
            loading="lazy"
            allowfullscreen
            allow="clipboard-write; autoplay"
            style="position:absolute;top:0;left:0;width:100%;height:100%;color-scheme:light;border:0"
          ></iframe>
        </div>
      </div>
      <!-- floating chips -->
