<script>
  // Hero ambient gradient follows mouse
  const hero = document.getElementById('top') as HTMLElement | null;
  if (hero) {
    window.addEventListener('mousemove', (ev) => {
      const e = ev as MouseEvent;
      const r = hero.getBoundingClientRect();
      if (e.clientY < r.top - 40 || e.clientY > r.bottom + 40) return;
      hero.style.setProperty('--mx', ((e.clientX - r.left) / r.width * 100) + '%');
      hero.style.setProperty('--my', ((e.clientY - r.top) / r.height * 100) + '%');
    }, { passive: true });
  }

  // Spotlight for .bhqSpot sections
  const spots = Array.from(document.querySelectorAll<HTMLElement>('.bhqSpot'));
  window.addEventListener('mousemove', (ev) => {
    const e = ev as MouseEvent;
    for (const el of spots) {
      const r = el.getBoundingClientRect();
      const inside = e.clientX >= r.left && e.clientX <= r.right && e.clientY >= r.top && e.clientY <= r.bottom;
      if (inside) {
        el.style.setProperty('--mx', (e.clientX - r.left) + 'px');
        el.style.setProperty('--my', (e.clientY - r.top) + 'px');
      } else {
        el.style.setProperty('--mx', '-400px');
        el.style.setProperty('--my', '-400px');
      }
    }
  }, { passive: true });
</script>

</BaseLayout>
