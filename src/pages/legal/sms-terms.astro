---
// Hand-written page. Unlike the other documents under /legal, SMS Terms has no
// canonical markdown in the breederhq repository, so scripts/sync-legal-documents.mjs
// does not generate it; it only lists it on the /legal index (STANDALONE_PAGES).
import BaseLayout from '../../layouts/BaseLayout.astro';

const breadcrumbs = [
  { name: 'Home', url: '/' },
  { name: 'Legal', url: '/legal' },
  { name: 'SMS Terms', url: '/legal/sms-terms' }
];
---

<BaseLayout
  title="SMS Terms - BreederHQ"
  description="The terms for BreederHQ Founders Program text messages: what we send, how often, how to opt out, and how to get help."
  breadcrumbs={breadcrumbs}
>
  <main>
    <section class="py-16 bg-white">
      <div class="mx-auto max-w-3xl px-4 sm:px-6 lg:px-8">
        <h1 class="text-3xl font-bold mt-10 mb-4 text-gray-900">SMS Terms</h1>
        <p class="mb-4 text-gray-700 leading-relaxed"><strong>Effective Date:</strong> October 3, 2026</p>
        <hr class="my-8 border-gray-200" />

        <h2 class="text-2xl font-semibold mt-8 mb-3 text-gray-900">1. The Program</h2>
        <p class="mb-4 text-gray-700 leading-relaxed">These terms apply to the BreederHQ Founders Program text messages, a text messaging program operated by BreederHQ LLC ("BreederHQ," "we," "our," or "us").</p>

        <h2 class="text-2xl font-semibold mt-8 mb-3 text-gray-900">2. What We Send</h2>
        <p class="mb-4 text-gray-700 leading-relaxed">We send transactional text messages to people who apply to the BreederHQ Founders Program and choose to receive texts. Examples are a link to schedule your onboarding demo and updates about your application. We do not send promotional or marketing texts through this program.</p>

        <h2 class="text-2xl font-semibold mt-8 mb-3 text-gray-900">3. How You Opt In</h2>
        <p class="mb-4 text-gray-700 leading-relaxed">You opt in by checking the optional text message checkbox on the Founders Program application at <a href="/pricing" class="text-[hsl(24,95%,45%)] underline">breederhq.com/pricing</a> and providing your mobile number. The checkbox is unchecked by default. Consent to receive texts is not a condition of any purchase, and you can apply to the Founders Program without it.</p>

        <h2 class="text-2xl font-semibold mt-8 mb-3 text-gray-900">4. Message Frequency and Rates</h2>
        <p class="mb-4 text-gray-700 leading-relaxed">Message frequency varies. Message and data rates may apply, depending on your mobile plan.</p>

        <h2 class="text-2xl font-semibold mt-8 mb-3 text-gray-900">5. Opting Out and Getting Help</h2>
        <p class="mb-4 text-gray-700 leading-relaxed">You can cancel at any time. Reply <strong>STOP</strong> to any message and you will receive one confirmation message and no further texts. Reply <strong>HELP</strong> for help. You can also reach us at <a href="mailto:support@breederhq.com" class="text-[hsl(24,95%,45%)] underline">support@breederhq.com</a>.</p>

        <h2 class="text-2xl font-semibold mt-8 mb-3 text-gray-900">6. Carriers</h2>
        <p class="mb-4 text-gray-700 leading-relaxed">Wireless carriers are not liable for delayed or undelivered messages.</p>

        <h2 class="text-2xl font-semibold mt-8 mb-3 text-gray-900">7. Privacy</h2>
        <p class="mb-4 text-gray-700 leading-relaxed">Our handling of your information is described in our <a href="/legal/privacy" class="text-[hsl(24,95%,45%)] underline">Privacy Policy</a>.</p>

        <h2 id="sms-privacy" class="text-2xl font-semibold mt-8 mb-3 text-gray-900">8. SMS Privacy</h2>
        <p class="mb-4 text-gray-700 leading-relaxed">For the Founders Program text messages, we collect your mobile number and a record of your consent: the wording shown to you, the time you agreed, and where you gave consent.</p>
        <p class="mb-4 text-gray-700 leading-relaxed">We use this information only to send the text messages of this program and to honor opt-out requests. We share it only with the service provider that delivers the messages, Amazon Web Services, and only to deliver them.</p>
        <p class="mb-4 text-gray-700 leading-relaxed">No mobile information will be shared with third parties or affiliates for marketing or promotional purposes. Text messaging opt-in data and consent will not be shared with any third parties.</p>
        <p class="mb-4 text-gray-700 leading-relaxed">You can opt out at any time by replying <strong>STOP</strong>. Your opt-out is recorded and honored.</p>
        <p class="mb-4 text-gray-700 leading-relaxed">The BreederHQ <a href="/legal/privacy" class="text-[hsl(24,95%,45%)] underline">Privacy Policy</a> covers all other handling of your data.</p>

        <div class="mt-12 pt-8 border-t border-gray-200 text-sm text-gray-600">
          <p>
            Questions about this document can go to
            <a href="mailto:legal@breederhq.com" class="text-[hsl(24,95%,45%)] underline">legal@breederhq.com</a>.
          </p>
          <p class="mt-3">
            <a href="/legal" class="text-[hsl(24,95%,45%)] underline">All legal documents</a>
          </p>
        </div>
      </div>
    </section>
  </main>
</BaseLayout>
