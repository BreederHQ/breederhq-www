---
// GENERATED FILE — DO NOT EDIT. See scripts/sync-legal-documents.mjs.
import BaseLayout from '../../layouts/BaseLayout.astro';

const breadcrumbs = [
  { name: 'Home', url: '/' },
  { name: 'Legal', url: '/legal' }
];
---

<BaseLayout
  title="Legal - BreederHQ"
  description="The agreements and policies governing use of BreederHQ, for breeders, service providers and buyers."
  breadcrumbs={breadcrumbs}
>
  <main>
    <section class="py-16 bg-white">
      <div class="mx-auto max-w-3xl px-4 sm:px-6 lg:px-8">
        <h1 class="text-4xl font-bold tracking-tight text-gray-900 mb-6">Legal</h1>
        <p class="text-lg text-gray-700 mb-8">
          These are the agreements and policies that govern use of BreederHQ.
          Which of them apply to you depends on how you use the platform.
        </p>
        <ul class="list-none p-0">
          <li class="border-b border-gray-100 py-4">
            <a href="/legal/terms" class="text-lg font-semibold text-[hsl(24,95%,45%)] underline">Terms of Service</a>
            <p class="mt-1 text-gray-700">The terms governing use of BreederHQ, covering the platform, the marketplace and the client portal.</p>
          </li>
          <li class="border-b border-gray-100 py-4">
            <a href="/legal/privacy" class="text-lg font-semibold text-[hsl(24,95%,45%)] underline">Privacy Policy</a>
            <p class="mt-1 text-gray-700">How BreederHQ collects, uses, shares and protects your data across the platform and mobile apps.</p>
          </li>
          <li class="border-b border-gray-100 py-4">
            <a href="/legal/acceptable-use" class="text-lg font-semibold text-[hsl(24,95%,45%)] underline">Acceptable Use Policy</a>
            <p class="mt-1 text-gray-700">What is and is not permitted on BreederHQ, and how BreederHQ responds to violations.</p>
          </li>
          <li class="border-b border-gray-100 py-4">
            <a href="/legal/buyer-terms" class="text-lg font-semibold text-[hsl(24,95%,45%)] underline">Buyer Terms</a>
            <p class="mt-1 text-gray-700">The terms that apply when browsing listings, joining waitlists, and buying animals or services on the BreederHQ Marketplace.</p>
          </li>
          <li class="border-b border-gray-100 py-4">
            <a href="/legal/seller-agreement" class="text-lg font-semibold text-[hsl(24,95%,45%)] underline">Breeder/Seller Agreement</a>
            <p class="mt-1 text-gray-700">The agreement breeders accept when listing animals on the BreederHQ Marketplace.</p>
          </li>
          <li class="border-b border-gray-100 py-4">
            <a href="/legal/service-provider-agreement" class="text-lg font-semibold text-[hsl(24,95%,45%)] underline">Service Provider Agreement</a>
            <p class="mt-1 text-gray-700">The agreement farriers, trainers, veterinarians, groomers, transporters and other animal-care professionals accept when offering services on BreederHQ.</p>
          </li>
          <li class="border-b border-gray-100 py-4">
            <a href="/legal/transaction-terms" class="text-lg font-semibold text-[hsl(24,95%,45%)] underline">Marketplace Transaction Terms</a>
            <p class="mt-1 text-gray-700">The terms governing transactions on the BreederHQ Marketplace, including payments, refunds, chargebacks and taxes.</p>
          </li>
          <li class="border-b border-gray-100 py-4">
            <a href="/legal/legal-definitions" class="text-lg font-semibold text-[hsl(24,95%,45%)] underline">Legal Definitions Schedule</a>
            <p class="mt-1 text-gray-700">The defined terms used across BreederHQ’s user agreements, incorporated by reference into every one of them.</p>
          </li>
        </ul>
        <div class="mt-12 pt-8 border-t border-gray-200 text-sm text-gray-600">
          <p>
            Questions can go to
            <a href="mailto:legal@breederhq.com" class="text-[hsl(24,95%,45%)] underline">legal@breederhq.com</a>.
          </p>
        </div>
      </div>
    </section>
  </main>
</BaseLayout>
