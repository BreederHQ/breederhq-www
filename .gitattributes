# Line endings are LF in the repository and in every checkout, whatever a machine's
# Git settings say, so byte-for-byte checks and diffs never depend on per-machine config.
* text=auto eol=lf

# Binary assets are never converted.
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.webp binary
*.ico binary
*.pdf binary
*.woff binary
*.woff2 binary
*.mp4 binary
